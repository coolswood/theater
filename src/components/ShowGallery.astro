---
import type { GalleryItem } from "../data/shows";
import { translations, type Language } from "../data/translations";

interface Props {
  gallery: GalleryItem[];
  lang?: Language;
}

const { gallery = [], lang = "ru" } = Astro.props;
const t = translations[lang]?.showPage || translations.ru.showPage;

// Balanced aspect ratios for a clean, aligned mosaic
const mosaicAspectsRow1 = [
  "aspect-[4/3]",
  "aspect-[3/4]",
  "aspect-[1/1]",
  "aspect-[4/5]",
  "aspect-[3/2]",
];
const mosaicAspectsRow2 = [
  "aspect-[3/4]",
  "aspect-[4/3]",
  "aspect-[4/5]",
  "aspect-[1/1]",
  "aspect-[3/2]",
];

// Duplicating & shifting items for mobile continuous loop with distinct row ordering
const halfLen = Math.floor(gallery.length / 2) || 2;
const row2Base = [
  ...gallery.slice(halfLen),
  ...gallery.slice(0, halfLen),
].reverse();

const row1Items = [...gallery, ...gallery, ...gallery, ...gallery];
const row2Items = [...row2Base, ...row2Base, ...row2Base, ...row2Base];

function getAltText(index: number) {
  if (lang === 'fi') return `Kuva esityksestä #${index + 1}`;
  if (lang === 'en') return `Show photo #${index + 1}`;
  return `Кадр со спектакля #${index + 1}`;
}
---

<section
  id="gallery"
  class="px-3 sm:px-10 py-12 sm:py-28 border-t border-rule bg-snow/50 overflow-hidden"
>
  <div class="max-w-[1400px] mx-auto">
    <!-- Section Header -->
    <div
      class="flex flex-col md:flex-row md:items-end justify-between gap-4 sm:gap-6 mb-8 sm:mb-16 reveal"
    >
      <div>
        <span class="suomi-tag mb-2 sm:mb-3" data-i18n="showPage.galleryTag"
          >{t.galleryTag}</span
        >
        <h2
          class="font-nordic font-extrabold text-granite text-3xl sm:text-6xl leading-none mt-1 sm:mt-2"
          data-i18n-html="showPage.galleryTitle"
          set:html={t.galleryTitle}
        />
      </div>
      <p
        class="font-sans text-xs sm:text-sm text-mute max-w-md border-l-2 border-suomi pl-3 py-0.5 sm:py-1"
        data-i18n="showPage.gallerySub"
      >
        {t.gallerySub}
      </p>
    </div>

    <!-- Mobile-Only Continuous Moving Marquee Ticker (sm:hidden) -->
    <div
      class="sm:hidden -mx-3 w-[calc(100%+1.5rem)] overflow-hidden space-y-3.5 py-2 select-none reveal"
      id="mosaic-marquee-container"
    >
      <!-- Row 1: Smooth Slow Drift (Left) -->
      <div
        id="marquee-track-1"
        class="flex gap-3.5 items-center w-max cursor-grab"
      >
        {
          row1Items.map((item, idx) => {
            const aspectClass =
              mosaicAspectsRow1[idx % mosaicAspectsRow1.length];
            const uniqueIndex = idx % gallery.length;
            return (
              <div
                class="gallery-card shrink-0 group relative overflow-hidden rounded-2xl border border-rule bg-white shadow-xs active:scale-98 transition-all cursor-pointer"
                data-index={uniqueIndex}
                data-src={item.src}
              >
                <div
                  class={`h-60 ${aspectClass} overflow-hidden relative bg-granite/5`}
                >
                  <img
                    src={item.src}
                    alt={getAltText(uniqueIndex)}
                    class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                    loading="lazy"
                    draggable="false"
                  />
                  <div class="absolute inset-0 bg-granite/30 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center backdrop-blur-[1px]">
                    <div class="w-8 h-8 rounded-full bg-white/95 text-granite flex items-center justify-center shadow-lg">
                      <svg
                        class="w-4 h-4 text-suomi shrink-0"
                        width="16"
                        height="16"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        viewBox="0 0 24 24"
                      >
                        <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" />
                      </svg>
                    </div>
                  </div>
                </div>
              </div>
            );
          })
        }
      </div>

      <!-- Row 2: Smooth Slow Drift (Right) -->
      <div
        id="marquee-track-2"
        class="flex gap-3.5 items-center w-max cursor-grab"
      >
        {
          row2Items.map((item, idx) => {
            const aspectClass =
              mosaicAspectsRow2[idx % mosaicAspectsRow2.length];
            const foundIdx = gallery.findIndex((g) => g.src === item.src);
            const uniqueIndex = foundIdx >= 0 ? foundIdx : idx % gallery.length;
            return (
              <div
                class="gallery-card shrink-0 group relative overflow-hidden rounded-2xl border border-rule bg-white shadow-xs active:scale-98 transition-all cursor-pointer"
                data-index={uniqueIndex}
                data-src={item.src}
              >
                <div
                  class={`h-60 ${aspectClass} overflow-hidden relative bg-granite/5`}
                >
                  <img
                    src={item.src}
                    alt={getAltText(uniqueIndex)}
                    class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                    loading="lazy"
                    draggable="false"
                  />
                  <div class="absolute inset-0 bg-granite/30 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center backdrop-blur-[1px]">
                    <div class="w-8 h-8 rounded-full bg-white/95 text-granite flex items-center justify-center shadow-lg">
                      <svg
                        class="w-4 h-4 text-suomi shrink-0"
                        width="16"
                        height="16"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        viewBox="0 0 24 24"
                      >
                        <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" />
                      </svg>
                    </div>
                  </div>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>

    <!-- Desktop Multi-Column Masonry Grid (hidden sm:block sm:columns-2 lg:columns-3) -->
    <div
      class="hidden sm:block sm:columns-2 lg:columns-3 gap-5 sm:gap-6 reveal"
      id="show-gallery-grid"
    >
      {
        gallery.map((item, idx) => (
          <div
            class="gallery-card break-inside-avoid group relative overflow-hidden rounded-2xl sm:rounded-3xl border border-rule bg-white shadow-xs hover:shadow-2xl transition-all duration-500 cursor-pointer mb-5 sm:mb-6"
            data-index={idx}
            data-src={item.src}
          >
            <div class="w-full overflow-hidden relative bg-granite/5">
              <img
                src={item.src}
                alt={getAltText(idx)}
                class="w-full h-auto object-cover block transition-transform duration-700 ease-out group-hover:scale-104"
                loading="lazy"
              />

              <div class="absolute inset-0 bg-granite/35 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center backdrop-blur-[2px]">
                <div class="px-5 py-2.5 rounded-full bg-white/95 text-granite text-xs font-nordic font-bold uppercase tracking-wider shadow-xl transform scale-90 group-hover:scale-100 transition-transform duration-300 flex items-center gap-2">
                  <svg
                    class="w-4 h-4 text-suomi shrink-0"
                    width="16"
                    height="16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    viewBox="0 0 24 24"
                  >
                    <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" />
                  </svg>
                  <span data-i18n="showPage.zoomPhoto">{t.zoomPhoto}</span>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- LIGHTBOX MODAL -->
<div
  id="gallery-lightbox"
  class="fixed inset-0 top-0 left-0 right-0 bottom-0 w-screen h-screen z-50 bg-granite/95 backdrop-blur-md hidden flex flex-col justify-between p-4 sm:p-8 opacity-0 transition-opacity duration-300"
>
  <!-- Lightbox Header Controls -->
  <div class="flex items-center justify-between z-10 w-full max-w-7xl mx-auto">
    <div class="flex items-center gap-3">
      <span class="w-2.5 h-2.5 rounded-full bg-redru animate-pulse"></span>
      <span
        id="lightbox-counter"
        class="font-nordic text-xs font-semibold tracking-widest text-snow/80 uppercase"
        >01 / 05</span
      >
    </div>

    <button
      id="lightbox-close"
      class="px-4 py-2 rounded-full bg-white/10 hover:bg-white/20 text-white font-nordic text-xs tracking-wider uppercase transition flex items-center gap-2 border border-white/15 cursor-pointer"
    >
      <span data-i18n="showPage.closeLightbox">{t.closeLightbox}</span>
      <svg
        class="w-4 h-4 shrink-0"
        width="16"
        height="16"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12"></path></svg
      >
    </button>
  </div>

  <!-- Main Image Display & Navigation Arrows -->
  <div
    class="relative flex-1 flex items-center justify-center my-2 overflow-hidden w-full max-w-7xl mx-auto"
  >
    <button
      id="lightbox-prev"
      class="absolute left-2 sm:left-4 z-20 w-12 h-12 rounded-full bg-white/10 hover:bg-suomi text-white flex items-center justify-center backdrop-blur-md border border-white/15 transition-all duration-200 hover:scale-110 cursor-pointer"
    >
      <svg
        class="w-6 h-6 shrink-0"
        width="24"
        height="24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"><path d="M15 19l-7-7 7-7"></path></svg
      >
    </button>

    <div class="w-full h-full p-2 flex items-center justify-center">
      <img
        id="lightbox-img"
        src=""
        alt=""
        class="max-w-[88vw] max-h-[82vh] object-contain rounded-2xl shadow-2xl transition-all duration-300 transform scale-95"
      />
    </div>

    <button
      id="lightbox-next"
      class="absolute right-2 sm:right-4 z-20 w-12 h-12 rounded-full bg-white/10 hover:bg-suomi text-white flex items-center justify-center backdrop-blur-md border border-white/15 transition-all duration-200 hover:scale-110 cursor-pointer"
    >
      <svg
        class="w-6 h-6 shrink-0"
        width="24"
        height="24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"></path></svg
      >
    </button>
  </div>

  <!-- Minimal Footer Spacer -->
  <div class="h-4"></div>
</div>

<script>
  function initGalleryScript() {
    const track1 = document.getElementById("marquee-track-1");
    const track2 = document.getElementById("marquee-track-2");
    const container = document.getElementById("mosaic-marquee-container");
    const cards = Array.from(
      document.querySelectorAll<HTMLElement>(".gallery-card"),
    );

    if (cards.length === 0) return;

    // --- 1. MOBILE RAF MARQUEE TICKER (Only runs on small screens) ---
    let pos1 = 0;
    let pos2 = 0;
    const slowSpeed = 0.15;
    let currentSpeed = slowSpeed;
    let targetSpeed = slowSpeed;
    let animId: number;

    if (container) {
      container.addEventListener("mouseenter", () => {
        targetSpeed = 0;
      });
      container.addEventListener("mouseleave", () => {
        targetSpeed = slowSpeed;
      });
      container.addEventListener(
        "touchstart",
        () => {
          targetSpeed = 0;
        },
        { passive: true },
      );
      container.addEventListener(
        "touchend",
        () => {
          targetSpeed = slowSpeed;
        },
        { passive: true },
      );
    }

    function step() {
      // Only animate on screens under 640px where track is visible
      if (window.innerWidth < 640) {
        currentSpeed += (targetSpeed - currentSpeed) * 0.1;

        if (track1) {
          const halfWidth1 = track1.scrollWidth / 2;
          if (halfWidth1 > 0) {
            pos1 -= currentSpeed;
            if (pos1 <= -halfWidth1) {
              pos1 += halfWidth1;
            }
            track1.style.transform = `translate3d(${pos1.toFixed(2)}px, 0, 0)`;
          }
        }

        if (track2) {
          const halfWidth2 = track2.scrollWidth / 2;
          if (halfWidth2 > 0) {
            if (pos2 === 0) pos2 = -halfWidth2 * 0.45;
            pos2 += currentSpeed * 0.8;
            if (pos2 >= 0) {
              pos2 -= halfWidth2;
            }
            track2.style.transform = `translate3d(${pos2.toFixed(2)}px, 0, 0)`;
          }
        }
      }

      animId = requestAnimationFrame(step);
    }

    animId = requestAnimationFrame(step);

    document.addEventListener(
      "astro:before-swap",
      () => {
        cancelAnimationFrame(animId);
      },
      { once: true },
    );

    // --- 2. LIGHTBOX MODAL LOGIC (Shared for Mobile & Desktop) ---
    const lightbox = document.getElementById("gallery-lightbox");
    if (lightbox && lightbox.parentElement !== document.body) {
      document.body.appendChild(lightbox);
    }

    const lightboxImg = document.getElementById(
      "lightbox-img",
    ) as HTMLImageElement;
    const lightboxCounter = document.getElementById("lightbox-counter");
    const closeBtn = document.getElementById("lightbox-close");
    const prevBtn = document.getElementById("lightbox-prev");
    const nextBtn = document.getElementById("lightbox-next");

    let currentIndex = 0;
    const uniquePhotos =
      document.querySelectorAll("#show-gallery-grid .gallery-card").length ||
      cards.length ||
      7;

    function openLightbox(index: number) {
      if (!lightbox) return;
      if (lightbox.parentElement !== document.body) {
        document.body.appendChild(lightbox);
      }
      currentIndex = index % uniquePhotos;
      updateLightboxContent();

      lightbox.classList.remove("hidden");
      setTimeout(() => {
        lightbox.classList.remove("opacity-0");
        if (lightboxImg) lightboxImg.classList.remove("scale-95");
      }, 10);
      document.body.style.overflow = "hidden";
    }

    function closeLightbox() {
      if (!lightbox) return;
      lightbox.classList.add("opacity-0");
      if (lightboxImg) lightboxImg.classList.add("scale-95");
      setTimeout(() => {
        lightbox.classList.add("hidden");
        document.body.style.overflow = "";
      }, 300);
    }

    function updateLightboxContent() {
      const card =
        cards.find(
          (c) =>
            parseInt(c.getAttribute("data-index") || "0", 10) === currentIndex,
        ) || cards[0];
      if (!card) return;

      const src = card.getAttribute("data-src") || "";

      if (lightboxImg) {
        lightboxImg.src = src;
      }
      if (lightboxCounter) {
        const currentStr = String(currentIndex + 1).padStart(2, "0");
        const totalStr = String(uniquePhotos).padStart(2, "0");
        lightboxCounter.textContent = `${currentStr} / ${totalStr}`;
      }
    }

    cards.forEach((card) => {
      const idxStr = card.getAttribute("data-index");
      const idx = idxStr !== null ? parseInt(idxStr, 10) : 0;
      card.addEventListener("click", () => openLightbox(idx));
    });

    closeBtn?.addEventListener("click", closeLightbox);

    prevBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      currentIndex = (currentIndex - 1 + uniquePhotos) % uniquePhotos;
      updateLightboxContent();
    });

    nextBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      currentIndex = (currentIndex + 1) % uniquePhotos;
      updateLightboxContent();
    });

    document.addEventListener("keydown", (e) => {
      if (!lightbox || lightbox.classList.contains("hidden")) return;
      if (e.key === "Escape") closeLightbox();
      if (e.key === "ArrowLeft") prevBtn?.click();
      if (e.key === "ArrowRight") nextBtn?.click();
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initGalleryScript);
  } else {
    initGalleryScript();
  }
</script>
