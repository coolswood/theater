---
import { centralCourse, courseSlides } from '../data/courses';
---

<section id="courses" class="px-3 sm:px-10 py-12 sm:py-32 border-t border-rule bg-birch/40 relative overflow-hidden">
  <!-- Decorative background accent -->
  <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-suomisoft/50 rounded-full blur-3xl -z-10 pointer-events-none"></div>
  <div class="max-w-[1400px] mx-auto">

    <!-- SECTION HEADER -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 sm:gap-8 mb-12 sm:mb-16 reveal">
      <div>
        <div class="flex items-center gap-3 mb-4">
          <span class="suomi-tag">{centralCourse.badge}</span>
          <span class="w-2 h-2 rounded-full bg-redru animate-pulse"></span>
        </div>
        <h2 class="font-nordic font-extrabold text-granite text-3xl sm:text-5xl lg:text-7xl leading-tight">
          Курс актерского мастерства<br />
          <span class="font-dramatic italic font-normal text-suomi">{centralCourse.studioName}.</span>
        </h2>
      </div>
      <div class="max-w-lg lg:pb-2">
        <p class="font-dramatic italic text-xl sm:text-3xl text-granite leading-snug mb-3">
          «{centralCourse.headline}»
        </p>
        <p class="text-sm text-mute font-light leading-relaxed">
          {centralCourse.description}
        </p>
      </div>
    </div>

    <!-- ==================== EDITORIAL STAGE PHOTO CAROUSEL ==================== -->
    <div class="mb-16 sm:mb-24 reveal">
      <div class="flex items-center justify-between mb-4 sm:mb-6">
        <div class="flex items-center gap-3">
          <span class="w-2.5 h-2.5 rounded-full bg-suomi"></span>
          <span class="font-mono text-xs text-suomi uppercase tracking-[0.2em] font-bold">Обучение и репетиции // Фотогалерея</span>
        </div>
        <div class="flex items-center gap-2 font-mono text-xs text-mute tracking-widest">
          <span id="slider-current-num" class="text-granite font-bold">01</span>
          <span>/</span>
          <span>05</span>
        </div>
      </div>

      <!-- MAIN DISPLAY SHOWCASE -->
      <div id="main-showcase-box" class="grid lg:grid-cols-12 gap-6 lg:gap-8 items-stretch rounded-2xl sm:rounded-3xl bg-snow border border-rule p-3 sm:p-8 shadow-lg overflow-hidden relative">
        
        <!-- MAIN PHOTO FRAME -->
        <div class="lg:col-span-7 relative aspect-[4/3] sm:aspect-[16/10] lg:aspect-auto rounded-xl sm:rounded-2xl overflow-hidden border border-rule group/frame bg-granite">
          <img
            id="showcase-img"
            src={courseSlides[0].image}
            alt={courseSlides[0].title}
            class="w-full h-full object-cover transition-all duration-700 ease-out transform group-hover/frame:scale-105"
          />
          
          <div class="absolute inset-0 bg-gradient-to-t from-granite/70 via-transparent to-transparent pointer-events-none"></div>

          <!-- Active Tag Badge -->
          <div id="showcase-tag" class="absolute top-3 left-3 sm:top-4 sm:left-4 bg-snow/90 backdrop-blur-md text-granite font-mono text-[10px] sm:text-xs uppercase tracking-[0.2em] px-3 py-1 sm:px-3.5 sm:py-1.5 rounded-full font-bold shadow">
            {courseSlides[0].tag}
          </div>

          <!-- Zoom Lightbox Trigger Button -->
          <button 
            id="showcase-zoom-btn"
            type="button" 
            class="absolute top-3 right-3 sm:top-4 sm:right-4 w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-granite/70 backdrop-blur-md text-white flex items-center justify-center hover:bg-suomi transition-all duration-300 shadow-md"
            title="Увеличить фото"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
          </button>
        </div>

        <!-- STAGE DETAILS SIDEBAR -->
        <div class="lg:col-span-5 flex flex-col justify-between p-2 sm:p-6 space-y-4 sm:space-y-6">
          <div>
            <span id="showcase-location" class="font-mono text-[11px] sm:text-xs text-suomi uppercase tracking-[0.2em] font-bold block mb-1.5 sm:mb-2">
              {courseSlides[0].location}
            </span>

            <h3 id="showcase-title" class="font-nordic font-extrabold text-xl sm:text-3xl text-granite leading-tight mb-2 sm:mb-3 transition-opacity duration-300">
              {courseSlides[0].title}
            </h3>

            <p id="showcase-subtitle" class="font-dramatic italic text-base sm:text-xl text-mute mb-4 sm:mb-6 transition-opacity duration-300">
              {courseSlides[0].subtitle}
            </p>

            <blockquote class="p-4 sm:p-5 rounded-xl sm:rounded-2xl bg-suomisoft/50 border-l-4 border-suomi space-y-1 sm:space-y-2">
              <p id="showcase-quote" class="font-dramatic italic text-sm sm:text-lg text-granite leading-relaxed transition-opacity duration-300">
                «{courseSlides[0].quote}»
              </p>
            </blockquote>
          </div>

          <!-- CONTROLS & THUMBNAILS CONTAINER -->
          <div class="pt-3 sm:pt-4 border-t border-rule space-y-3 sm:space-y-4">
            <div class="flex items-center justify-between">
              <span class="font-mono text-[10px] sm:text-[11px] text-mute uppercase tracking-widest">Выберите этап</span>
              <div class="flex items-center gap-2">
                <button
                  id="slider-prev"
                  class="w-9 h-9 sm:w-10 sm:h-10 rounded-full border border-rule bg-snow text-granite flex items-center justify-center hover:bg-suomi hover:text-white transition-all shadow-sm"
                  aria-label="Предыдущее фото"
                >
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
                </button>
                <button
                  id="slider-next"
                  class="w-9 h-9 sm:w-10 sm:h-10 rounded-full border border-rule bg-snow text-granite flex items-center justify-center hover:bg-suomi hover:text-white transition-all shadow-sm"
                  aria-label="Следующее фото"
                >
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
                </button>
              </div>
            </div>

            <!-- THUMBNAIL FILMSTRIP -->
            <div id="thumbnail-filmstrip" class="flex gap-2 sm:gap-2.5 overflow-x-auto pb-1.5 scrollbar-none">
              {courseSlides.map((slide, index) => (
                <button
                  type="button"
                  class="thumb-item shrink-0 w-14 h-14 sm:w-20 sm:h-20 rounded-lg sm:rounded-xl overflow-hidden border-2 border-transparent transition-all duration-300 relative group/thumb focus:outline-none"
                  data-index={index}
                  title={slide.title}
                >
                  <img src={slide.image} alt={slide.title} class="w-full h-full object-cover group-hover/thumb:scale-110 transition-transform duration-300" />
                  <div class="absolute inset-0 bg-granite/40 group-hover/thumb:bg-transparent transition-colors"></div>
                  <span class="absolute bottom-1 right-1 font-mono text-[9px] sm:text-[10px] font-bold text-white bg-granite/80 px-1 rounded">0{index + 1}</span>
                </button>
              ))}
            </div>
          </div>

        </div>

      </div>

      <!-- Progress Line -->
      <div class="w-full bg-rule h-1 rounded-full mt-3 sm:mt-4 overflow-hidden">
        <div id="slider-progress" class="bg-suomi h-full w-1/5 transition-all duration-500 ease-out"></div>
      </div>
    </div>

    <!-- ==================== MAIN COURSE PRESENTATION SHOWCASE ==================== -->
    <div class="reveal p-0 sm:p-14 rounded-none sm:rounded-3xl bg-transparent sm:bg-snow border-0 sm:border-2 border-suomi/30 shadow-none sm:shadow-xl relative overflow-hidden max-w-full">
      <!-- Decorative Tag -->
      <div class="hidden sm:block absolute top-0 right-0 bg-suomi text-white font-nordic text-[10px] uppercase tracking-[0.25em] px-6 py-2.5 rounded-bl-2xl font-bold shadow-md">
        Официальный курс Logrus Teatteri
      </div>

      <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-start sm:mt-4 max-w-full">
        
        <!-- LEFT: WHAT YOU GET -->
        <div class="lg:col-span-7 space-y-6 sm:space-y-8 max-w-full overflow-hidden">
          <div>
            <span class="font-mono text-[11px] sm:text-xs uppercase tracking-[0.15em] sm:tracking-[0.25em] text-suomi font-bold block mb-2 break-words">{centralCourse.subtitle}</span>
            <h3 class="font-nordic font-extrabold text-granite text-xl sm:text-4xl lg:text-5xl leading-tight mb-3 break-words">
              Курс актерского мастерства <span class="text-suomi block sm:inline">{centralCourse.studioName}</span>
            </h3>
            <p class="font-dramatic italic text-base sm:text-xl text-mute leading-relaxed mb-4 break-words">
              «{centralCourse.headline}»
            </p>
            <p class="dropcap text-granite/85 text-sm sm:text-lg leading-relaxed font-light break-words">
              {centralCourse.description}
            </p>
          </div>

          <!-- 4 PILLARS GRID / SLIDER -->
          <div class="max-w-full">
            <div class="flex items-center justify-between mb-3">
              <h4 class="font-nordic font-bold text-sm sm:text-lg text-granite flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-suomi inline-block"></span>
                Что дает обучение на курсе:
              </h4>
              <span class="font-mono text-[10px] text-mute uppercase tracking-widest sm:hidden">Свайп →</span>
            </div>
            
            <div class="flex md:grid md:grid-cols-2 gap-4 md:gap-6 overflow-x-auto md:overflow-visible snap-x snap-mandatory scrollbar-none pb-2 max-w-full">
              {centralCourse.pillars.map((pillar) => (
                <div class="w-[260px] sm:w-[320px] md:w-full md:max-w-none shrink-0 md:shrink snap-center p-5 md:p-7 rounded-xl md:rounded-2xl bg-snow border border-rule shadow-sm md:shadow-none flex flex-col justify-between">
                  <div>
                    <span class="font-mono text-xs text-suomi font-bold tracking-widest">{pillar.num} // ЭТАП</span>
                    <h5 class="font-nordic font-bold text-granite text-base md:text-lg lg:text-xl mt-2 mb-1.5 break-words">{pillar.title}</h5>
                  </div>
                  <p class="text-xs md:text-sm lg:text-base text-mute leading-relaxed font-light mt-1">{pillar.desc}</p>
                </div>
              ))}
            </div>
          </div>

          <!-- TARGET AUDIENCE -->
          <div class="p-4 sm:p-6 rounded-xl sm:rounded-2xl bg-suomisoft/40 border border-rule max-w-full">
            <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-suomi font-bold mb-1">Кому подходит этот курс?</p>
            <p class="text-xs sm:text-base text-granite/90 font-light leading-relaxed">
              {centralCourse.targetAudience}
            </p>
          </div>

          <!-- CLOSING MOTTO BANNER -->
          <div class="pt-3 border-t border-rule flex items-center justify-between">
            <span class="font-dramatic italic text-lg sm:text-2xl text-suomi font-semibold">{centralCourse.closingQuote}</span>
            <span class="font-mono text-xs uppercase tracking-widest text-mute hidden sm:inline">Helsinki · 2026</span>
          </div>

        </div>

        <!-- RIGHT: REGISTRATION & ACTION CARD -->
        <div class="lg:col-span-5 bg-snow border-2 border-suomi/40 text-granite p-4 sm:p-10 rounded-2xl sm:rounded-3xl space-y-6 sm:space-y-8 shadow-xl flex flex-col justify-between h-full relative overflow-hidden max-w-full">
          
          <!-- Background decoration tag -->
          <div class="absolute -bottom-10 -right-10 w-40 h-40 bg-suomisoft rounded-full blur-2xl -z-10 pointer-events-none"></div>

          <div>
            <!-- Spotlight badge -->
            <div class="inline-flex items-center gap-2 px-3.5 py-1 sm:px-4 sm:py-1.5 rounded-full bg-suomisoft border border-suomi/20 text-[10px] sm:text-xs font-mono uppercase tracking-widest text-suomi font-bold mb-4 sm:mb-6 max-w-full overflow-hidden">
              <span class="w-2 h-2 rounded-full bg-redru animate-ping shrink-0"></span>
              <span class="truncate">{centralCourse.badge}</span>
            </div>

            <!-- Free Trial Highlight Box (Vibrant Suomi Blue on Light Background) -->
            <div class="p-4 sm:p-6 rounded-xl sm:rounded-2xl bg-suomi text-white shadow-lg mb-6 sm:mb-8 text-center sm:text-left relative overflow-hidden group/trial">
              <div class="absolute -right-6 -bottom-6 w-24 h-24 bg-white/10 rounded-full blur-xl pointer-events-none"></div>
              <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-suomisoft block mb-1 font-semibold">Специальное предложение</span>
              <p class="font-nordic font-extrabold text-lg sm:text-3xl text-white leading-tight break-words">
                {centralCourse.trialInfo}
              </p>
              <p class="text-xs text-white/90 font-light mt-1.5">Приди и попробуй сценическое взаимодействие без обязательств.</p>
            </div>

            <!-- Contact & Venue Details -->
            <div class="space-y-4 sm:space-y-5 font-mono text-xs max-w-full">
              <div class="border-b border-rule pb-3 sm:pb-4">
                <span class="text-suomi uppercase tracking-[0.2em] block mb-1 font-bold">Телефон / WhatsApp</span>
                <a href={`tel:${centralCourse.phone.replace(/\s+/g, '')}`} class="font-nordic font-bold text-base sm:text-xl text-granite hover:text-suomi transition block break-all">
                  {centralCourse.phone}
                </a>
              </div>

              <div class="border-b border-rule pb-3 sm:pb-4">
                <span class="text-suomi uppercase tracking-[0.2em] block mb-1 font-bold">Электронная почта</span>
                <a href={`mailto:${centralCourse.email}`} class="font-nordic font-bold text-sm sm:text-lg text-granite hover:text-suomi transition block break-all">
                  {centralCourse.email}
                </a>
              </div>

              <div class="border-b border-rule pb-3 sm:pb-4">
                <span class="text-suomi uppercase tracking-[0.2em] block mb-1 font-bold">Локация</span>
                <p class="text-xs sm:text-sm text-granite font-sans font-medium break-words">{centralCourse.location}</p>
              </div>

              <div>
                <span class="text-suomi uppercase tracking-[0.2em] block mb-1 font-bold">Формат занятий</span>
                <p class="text-xs text-mute font-sans font-light break-words">{centralCourse.schedule}</p>
              </div>
            </div>
          </div>

          <!-- Main CTA Button -->
          <div class="pt-4 sm:pt-6 border-t border-rule max-w-full">
            <button
              class="enroll-trigger-btn w-full btn-suomi font-nordic text-[11px] sm:text-xs tracking-wider uppercase font-semibold py-3.5 sm:py-4 px-3 rounded-full inline-flex items-center justify-center gap-2 sm:gap-3 group shadow-lg break-words text-center"
              data-course={`Курс актерского мастерства ${centralCourse.studioName}`}
            >
              Записаться на бесплатное занятие
              <svg class="arrow shrink-0" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </button>
            <p class="font-mono text-[10px] text-mute text-center mt-2">Количество мест в группе ограничено (до 15 человек)</p>
          </div>

        </div>

      </div>
    </div>

    <!-- ENROLLMENT FORM MODAL -->
    <div id="enrollment-modal" class="fixed inset-0 z-50 bg-granite/80 backdrop-blur-sm hidden items-center justify-center p-4 transition-all duration-300">
      <div class="bg-snow w-full max-w-lg rounded-3xl p-6 sm:p-10 border border-rule shadow-2xl relative transform transition-all max-h-[90vh] overflow-y-auto">
        
        <button id="modal-close" class="absolute top-6 right-6 w-10 h-10 rounded-full border border-rule text-mute hover:text-granite hover:bg-snow2 flex items-center justify-center text-xl transition">
          ✕
        </button>

        <span class="suomi-tag block mb-3">Запись в студию // 2026</span>
        <h3 class="font-nordic font-bold text-2xl text-granite mb-1">Бесплатное пробное занятие</h3>
        <p id="modal-course-name" class="font-dramatic italic text-suomi text-lg mb-6">Курс актерского мастерства «Лампарельс»</p>

        <form id="enrollment-form" class="space-y-4" onsubmit="event.preventDefault(); handleFormSubmit();">
          <div>
            <label class="block font-mono text-[10px] uppercase tracking-wider text-mute mb-1">Ваше Имя и Фамилия</label>
            <input type="text" required placeholder="Анна Иванова" class="w-full bg-snow2 border border-rule rounded-xl px-4 py-3 text-granite focus:outline-none focus:border-suomi font-sans text-sm" />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block font-mono text-[10px] uppercase tracking-wider text-mute mb-1">Телефон / WhatsApp</label>
              <input type="text" required placeholder="+358..." class="w-full bg-snow2 border border-rule rounded-xl px-4 py-3 text-granite focus:outline-none focus:border-suomi font-mono text-sm" />
            </div>
            <div>
              <label class="block font-mono text-[10px] uppercase tracking-wider text-mute mb-1">Email</label>
              <input type="email" required placeholder="name@domain.fi" class="w-full bg-snow2 border border-rule rounded-xl px-4 py-3 text-granite focus:outline-none focus:border-suomi font-mono text-sm" />
            </div>
          </div>

          <div>
            <label class="block font-mono text-[10px] uppercase tracking-wider text-mute mb-1">Вопрос или комментарий (опционально)</label>
            <textarea rows="3" placeholder="Расскажите о своем опыте или пожеланиях..." class="w-full bg-snow2 border border-rule rounded-xl px-4 py-3 text-granite focus:outline-none focus:border-suomi font-sans text-sm"></textarea>
          </div>

          <div class="pt-2">
            <button type="submit" class="w-full btn-suomi font-nordic text-xs uppercase tracking-wider font-semibold py-4 rounded-full shadow-lg">
              Забронировать бесплатное место
            </button>
          </div>
          <p class="font-mono text-[10px] text-mute text-center">Или позвоните нам напрямую: <a href="tel:+358452656332" class="text-suomi font-bold underline">+358 45 2656332</a></p>
        </form>

        <div id="form-success-message" class="hidden text-center py-8">
          <span class="w-16 h-16 bg-suomisoft text-suomi rounded-full inline-flex items-center justify-center text-3xl font-bold mb-4">✓</span>
          <h4 class="font-nordic font-bold text-2xl text-granite mb-2">Заявка успешно отправлена!</h4>
          <p class="text-sm text-mute max-w-xs mx-auto mb-6">Ждем вас на первом пробном занятии курса «Лампарельс». Администратор Logrus связался с вами в течение 24 часов.</p>
          <button id="success-close" class="btn-outline font-nordic text-xs uppercase tracking-wider px-6 py-2.5 rounded-full">Отлично</button>
        </div>

      </div>
    </div>

    <!-- LIGHTBOX PHOTO MODAL -->
    <div id="lightbox-modal" class="fixed inset-0 z-50 bg-granite/90 backdrop-blur-md hidden items-center justify-center p-4">
      <button id="lightbox-close" class="absolute top-6 right-6 text-white text-3xl hover:text-suomisoft transition">✕</button>
      <div class="max-w-4xl max-h-[85vh] relative">
        <img id="lightbox-img" src="" alt="Zoom Photo" class="max-w-full max-h-[80vh] rounded-2xl object-contain shadow-2xl border border-white/20" />
        <p id="lightbox-caption" class="text-center text-white font-nordic text-sm mt-4 tracking-wider"></p>
      </div>
    </div>

  </div>
</section>

<!-- CAROUSEL SCRIPT -->
<script>
  import { courseSlides } from '../data/courses';

  function initCoursesCarousel() {
    let currentIndex = 0;
    const totalSlides = courseSlides.length;

    const showcaseImg = document.getElementById('showcase-img') as HTMLImageElement;
    const showcaseTag = document.getElementById('showcase-tag');
    const showcaseLocation = document.getElementById('showcase-location');
    const showcaseTitle = document.getElementById('showcase-title');
    const showcaseSubtitle = document.getElementById('showcase-subtitle');
    const showcaseQuote = document.getElementById('showcase-quote');
    const currentNumEl = document.getElementById('slider-current-num');
    const progressEl = document.getElementById('slider-progress');
    const showcaseZoomBtn = document.getElementById('showcase-zoom-btn');
    const prevBtn = document.getElementById('slider-prev');
    const nextBtn = document.getElementById('slider-next');
    const thumbItems = Array.from(document.querySelectorAll('.thumb-item'));
    const mainShowcaseBox = document.getElementById('main-showcase-box');

    if (!showcaseImg) return;

    function goToSlide(index: number) {
      currentIndex = (index + totalSlides) % totalSlides;
      const data = courseSlides[currentIndex];

      // Smooth Crossfade effect
      showcaseImg.style.opacity = '0.3';
      showcaseImg.style.transform = 'scale(0.98)';

      setTimeout(() => {
        showcaseImg.src = data.image;
        showcaseImg.alt = data.title;
        if (showcaseTag) showcaseTag.textContent = data.tag;
        if (showcaseLocation) showcaseLocation.textContent = data.location;
        if (showcaseTitle) showcaseTitle.textContent = data.title;
        if (showcaseSubtitle) showcaseSubtitle.textContent = data.subtitle;
        if (showcaseQuote) showcaseQuote.textContent = `«${data.quote}»`;
        if (currentNumEl) currentNumEl.textContent = `0${currentIndex + 1}`;
        if (progressEl) progressEl.style.width = `${((currentIndex + 1) / totalSlides) * 100}%`;

        showcaseImg.style.opacity = '1';
        showcaseImg.style.transform = 'scale(1)';
      }, 180);

      // Update thumbnails active border
      thumbItems.forEach((item, idx) => {
        if (idx === currentIndex) {
          item.classList.add('border-suomi', 'scale-105');
          item.classList.remove('border-transparent');
        } else {
          item.classList.remove('border-suomi', 'scale-105');
          item.classList.add('border-transparent');
        }
      });
    }

    prevBtn?.addEventListener('click', () => goToSlide(currentIndex - 1));
    nextBtn?.addEventListener('click', () => goToSlide(currentIndex + 1));

    thumbItems.forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = parseInt(btn.getAttribute('data-index') || '0', 10);
        goToSlide(idx);
      });
    });

    // Touch Swipe on Main Showcase Box
    let touchStartX = 0;
    let touchEndX = 0;

    mainShowcaseBox?.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    mainShowcaseBox?.addEventListener('touchend', (e) => {
      touchEndX = e.changedTouches[0].screenX;
      if (touchStartX - touchEndX > 40) {
        goToSlide(currentIndex + 1);
      } else if (touchEndX - touchStartX > 40) {
        goToSlide(currentIndex - 1);
      }
    }, { passive: true });

    // Lightbox modal logic
    const lightbox = document.getElementById('lightbox-modal');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
    const lightboxCaption = document.getElementById('lightbox-caption');
    const lightboxClose = document.getElementById('lightbox-close');

    showcaseZoomBtn?.addEventListener('click', () => {
      const data = courseSlides[currentIndex];
      if (lightbox && lightboxImg) {
        lightboxImg.src = data.image;
        if (lightboxCaption) lightboxCaption.textContent = `${data.tag} — ${data.title}`;
        lightbox.classList.remove('hidden');
        lightbox.classList.add('flex');
      }
    });

    lightboxClose?.addEventListener('click', () => {
      lightbox?.classList.add('hidden');
      lightbox?.classList.remove('flex');
    });

    lightbox?.addEventListener('click', (e) => {
      if (e.target === lightbox) {
        lightbox.classList.add('hidden');
        lightbox.classList.remove('flex');
      }
    });

    // Modal enrollment logic
    const modal = document.getElementById('enrollment-modal');
    const modalClose = document.getElementById('modal-close');
    const successClose = document.getElementById('success-close');
    const courseNameEl = document.getElementById('modal-course-name');
    const enrollBtns = document.querySelectorAll('.enroll-trigger-btn');
    const form = document.getElementById('enrollment-form') as HTMLFormElement;
    const successMsg = document.getElementById('form-success-message');

    enrollBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const courseName = btn.getAttribute('data-course') || 'Курс актерского мастерства «Лампарельс»';
        if (courseNameEl) courseNameEl.textContent = courseName;
        if (form) form.classList.remove('hidden');
        if (successMsg) successMsg.classList.add('hidden');
        modal?.classList.remove('hidden');
        modal?.classList.add('flex');
      });
    });

    modalClose?.addEventListener('click', () => {
      modal?.classList.add('hidden');
      modal?.classList.remove('flex');
    });

    successClose?.addEventListener('click', () => {
      modal?.classList.add('hidden');
      modal?.classList.remove('flex');
    });

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }
    });

    // Initial slide
    goToSlide(0);
  }

  (window as any).handleFormSubmit = function() {
    const form = document.getElementById('enrollment-form');
    const successMsg = document.getElementById('form-success-message');
    if (form && successMsg) {
      form.classList.add('hidden');
      successMsg.classList.remove('hidden');
    }
  };

  document.addEventListener('DOMContentLoaded', initCoursesCarousel);
</script>
