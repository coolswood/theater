---
import { getCentralCourse, getCourseSlides } from '../data/courses';
import { translations } from '../data/translations';

const t = translations.ru.courses;
const centralCourse = getCentralCourse('ru');
const courseSlides = getCourseSlides('ru');
---

<section id="courses" class="px-3 sm:px-10 py-14 sm:py-32 border-t border-rule bg-birch/40 relative overflow-hidden">
  <!-- Decorative background accent -->
  <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-suomisoft/50 rounded-full blur-3xl -z-10 pointer-events-none"></div>

  <div class="max-w-[1400px] mx-auto">

    <!-- SECTION HEADER -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-12 sm:mb-16 reveal">
      <div>
        <div class="flex items-center gap-3 mb-3 sm:mb-4">
          <span class="suomi-tag font-bold" data-i18n="courses.centralCourse.badge">{centralCourse.badge}</span>
          <span class="w-2.5 h-2.5 rounded-full bg-redru animate-pulse"></span>
        </div>
        <h2 class="font-nordic font-extrabold text-granite text-3xl sm:text-6xl lg:text-7xl leading-tight">
          <span data-i18n="courses.centralCourse.title">{centralCourse.title}</span><br />
          <span class="text-suomi font-extrabold" data-i18n="courses.centralCourse.studioName">{centralCourse.studioName}.</span>
        </h2>
      </div>
      <div class="max-w-xl lg:pb-1">
        <p class="font-sans font-semibold text-xl sm:text-3xl text-granite leading-snug">
          «<span data-i18n="courses.centralCourse.headline">{centralCourse.headline}</span>»
        </p>
      </div>
    </div>

    <!-- ==================== UNIFIED MASTER SHOWCASE CONTAINER ==================== -->
    <div class="reveal rounded-2xl sm:rounded-3xl bg-snow border border-suomi/30 shadow-2xl p-6 sm:p-10 lg:p-14 relative overflow-hidden">
      
      <!-- Top Decorative Tag (Desktop) -->
      <div class="hidden lg:block absolute top-0 right-0 bg-suomi text-white font-nordic text-[11px] uppercase tracking-[0.25em] px-7 py-2.5 rounded-bl-2xl font-bold shadow-md">
        Logrus Teatteri · Helsinki
      </div>

      <div class="grid lg:grid-cols-12 gap-10 lg:gap-14 items-stretch">
        
        <!-- LEFT COLUMN: STAGE PHOTO CAROUSEL (6 cols) -->
        <div class="lg:col-span-6 space-y-6 flex flex-col justify-between">
          <div id="main-showcase-box" class="space-y-4">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-suomi"></span>
                <span class="font-sans text-xs text-suomi uppercase tracking-[0.2em] font-bold" data-i18n="courses.tag">{t.tag}</span>
              </div>
              <div class="flex items-center gap-2 font-sans text-xs sm:text-sm text-mute tracking-widest">
                <span id="slider-current-num" class="text-granite font-bold">01</span>
                <span>/</span>
                <span>05</span>
              </div>
            </div>

            <!-- MAIN PHOTO FRAME -->
            <div class="relative aspect-[16/10] rounded-xl sm:rounded-2xl overflow-hidden border border-rule group/frame bg-granite shadow-md">
              <img
                id="showcase-img"
                src={courseSlides[0].image}
                alt={courseSlides[0].title}
                class="w-full h-full object-cover transition-all duration-700 ease-out transform group-hover/frame:scale-105"
              />
              
              <div class="absolute inset-0 bg-gradient-to-t from-granite/70 via-transparent to-transparent pointer-events-none"></div>

              <!-- Active Tag Badge -->
              <div id="showcase-tag" class="absolute top-3 left-3 sm:top-4 sm:left-4 bg-snow/90 backdrop-blur-md text-granite font-sans text-xs uppercase tracking-[0.2em] px-3.5 py-1.5 rounded-full font-bold shadow">
                {courseSlides[0].tag}
              </div>

              <!-- Zoom Lightbox Trigger Button -->
              <button 
                id="showcase-zoom-btn"
                type="button" 
                class="absolute top-3 right-3 sm:top-4 sm:right-4 w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-granite/70 backdrop-blur-md text-white flex items-center justify-center hover:bg-suomi transition-all duration-300 shadow-md"
                title="Увеличить фото"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
              </button>
            </div>

            <!-- STAGE DETAILS & CONTROLS -->
            <div class="pt-2 space-y-4">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <span id="showcase-location" class="font-sans text-xs text-suomi uppercase tracking-[0.15em] font-bold block mb-1">
                    {courseSlides[0].location}
                  </span>
                  <h3 id="showcase-title" class="font-nordic font-extrabold text-xl sm:text-3xl text-granite leading-tight mb-1.5 transition-opacity duration-300">
                    {courseSlides[0].title}
                  </h3>
                  <p id="showcase-subtitle" class="font-sans text-base sm:text-lg text-mute font-light transition-opacity duration-300">
                    {courseSlides[0].subtitle}
                  </p>
                </div>
                <div class="flex items-center gap-2 shrink-0 pt-1">
                  <button
                    id="slider-prev"
                    class="w-9 h-9 sm:w-10 sm:h-10 rounded-full border border-rule bg-snow text-granite flex items-center justify-center hover:bg-suomi hover:text-white transition-all shadow-sm"
                    aria-label="Предыдущее фото"
                  >
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
                  </button>
                  <button
                    id="slider-next"
                    class="w-9 h-9 sm:w-10 sm:h-10 rounded-full border border-rule bg-snow text-granite flex items-center justify-center hover:bg-suomi hover:text-white transition-all shadow-sm"
                    aria-label="Следующее фото"
                  >
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
                  </button>
                </div>
              </div>

              <!-- Quote Box -->
              <blockquote class="p-4 sm:p-5 rounded-xl sm:rounded-2xl bg-suomisoft/50 border-l-4 border-suomi">
                <p id="showcase-quote" class="font-sans text-sm sm:text-base text-granite font-medium leading-relaxed transition-opacity duration-300">
                  «{courseSlides[0].quote}»
                </p>
              </blockquote>

              <!-- Thumbnail Filmstrip & Progress Bar -->
              <div class="space-y-3 pt-1">
                <div id="thumbnail-filmstrip" class="flex gap-2.5 overflow-x-auto pb-1.5 scrollbar-none">
                  {courseSlides.map((slide, index) => (
                    <button
                      type="button"
                      class="thumb-item shrink-0 w-14 h-14 sm:w-18 sm:h-18 rounded-xl overflow-hidden border-2 border-transparent transition-all duration-300 relative group/thumb focus:outline-none"
                      data-index={index}
                      title={slide.title}
                    >
                      <img src={slide.image} alt={slide.title} class="w-full h-full object-cover group-hover/thumb:scale-110 transition-transform duration-300" />
                      <div class="absolute inset-0 bg-granite/40 group-hover/thumb:bg-transparent transition-colors"></div>
                      <span class="absolute bottom-1 right-1 font-sans text-[9px] sm:text-[10px] font-bold text-white bg-granite/80 px-1 rounded">0{index + 1}</span>
                    </button>
                  ))}
                </div>
                <div class="w-full bg-rule h-1.5 rounded-full overflow-hidden">
                  <div id="slider-progress" class="bg-suomi h-full w-1/5 transition-all duration-500 ease-out"></div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- RIGHT COLUMN: PROGRAM PILLARS, DETAILS, FREE TRIAL & CTA (6 cols) -->
        <div class="lg:col-span-6 space-y-6 sm:space-y-8 flex flex-col justify-between h-full">
          
          <!-- COURSE DESCRIPTION & AUDIENCE -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="p-4 sm:p-5 rounded-2xl bg-birch/40 border border-rule space-y-1.5">
              <span class="font-sans text-xs uppercase tracking-[0.2em] text-suomi font-bold block" data-i18n="courses.centralCourse.subtitle">{centralCourse.subtitle}</span>
              <p class="text-sm sm:text-base text-granite/90 font-light leading-relaxed" data-i18n="courses.centralCourse.description">
                {centralCourse.description}
              </p>
            </div>

            <div class="p-4 sm:p-5 rounded-2xl bg-suomisoft/30 border border-rule space-y-1.5">
              <span class="font-sans text-xs uppercase tracking-[0.2em] text-suomi font-bold block">Для кого этот курс</span>
              <p class="text-sm sm:text-base text-granite/90 font-light leading-relaxed" data-i18n="courses.centralCourse.targetAudience">
                {centralCourse.targetAudience}
              </p>
            </div>
          </div>

          <!-- PROGRAM PILLARS GRID (2x2) -->
          <div class="space-y-3">
            <h4 class="font-nordic font-bold text-base sm:text-lg text-granite flex items-center gap-2.5">
              <span class="w-2.5 h-2.5 rounded-full bg-suomi inline-block"></span>
              <span>4 ключевых направления программы</span>
            </h4>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
              {centralCourse.pillars.map((pillar, idx) => (
                <div class="p-4 sm:p-5 rounded-2xl bg-birch/30 border border-rule/70 flex flex-col justify-between space-y-2 hover:border-suomi/40 transition">
                  <div>
                    <span class="font-sans text-[10px] text-suomi font-bold tracking-widest block mb-1">{pillar.num} // STAGE</span>
                    <h5 class="font-nordic font-bold text-granite text-sm sm:text-base leading-snug" data-i18n={`courses.centralCourse.pillars.${idx}.title`}>{pillar.title}</h5>
                  </div>
                  <p class="text-xs sm:text-sm text-mute font-light leading-relaxed" data-i18n={`courses.centralCourse.pillars.${idx}.desc`}>{pillar.desc}</p>
                </div>
              ))}
            </div>
          </div>

          <!-- FREE TRIAL HIGHLIGHT BANNER -->
          <div class="p-5 sm:p-7 rounded-2xl bg-suomi text-white shadow-xl relative overflow-hidden group/trial flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div class="absolute -right-6 -bottom-6 w-32 h-32 bg-white/10 rounded-full blur-xl pointer-events-none"></div>
            <div>
              <span class="font-sans text-xs uppercase tracking-[0.2em] text-suomisoft block mb-1 font-semibold">Special Offer</span>
              <p class="font-nordic font-extrabold text-2xl sm:text-3xl text-white leading-tight" data-i18n="courses.centralCourse.trialInfo">
                {centralCourse.trialInfo}
              </p>
            </div>
            <p class="text-xs sm:text-sm text-white/90 font-light text-left sm:text-right shrink-0 sm:max-w-[170px]" data-i18n="courses.centralCourse.schedule">{centralCourse.schedule}</p>
          </div>

          <!-- CONTACT & LOCATION INFO -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 font-sans text-xs sm:text-sm bg-birch/20 p-4 rounded-2xl border border-rule">
            <div class="sm:border-r border-rule sm:pr-3">
              <span class="text-suomi uppercase tracking-widest font-bold text-[10px] sm:text-xs block mb-0.5">Телефон / WA</span>
              <a href={`tel:${centralCourse.phone.replace(/\s+/g, '')}`} class="font-nordic font-bold text-sm sm:text-base text-granite hover:text-suomi transition truncate block">
                {centralCourse.phone}
              </a>
            </div>

            <div class="sm:border-r border-rule sm:pr-3">
              <span class="text-suomi uppercase tracking-widest font-bold text-[10px] sm:text-xs block mb-0.5">Email</span>
              <a href={`mailto:${centralCourse.email}`} class="font-nordic font-bold text-xs sm:text-sm text-granite hover:text-suomi transition truncate block">
                {centralCourse.email}
              </a>
            </div>

            <div>
              <span class="text-suomi uppercase tracking-widest font-bold text-[10px] sm:text-xs block mb-0.5">Локация</span>
              <span class="text-xs sm:text-sm text-granite font-medium truncate block" data-i18n="courses.centralCourse.location">{centralCourse.location}</span>
            </div>
          </div>

          <!-- MAIN CTA ENROLL BUTTON -->
          <div>
            <button
              class="enroll-trigger-btn w-full btn-suomi font-nordic text-xs sm:text-sm tracking-wider uppercase font-semibold py-4.5 sm:py-5 px-6 rounded-full inline-flex items-center justify-center gap-3 group shadow-xl text-center"
              data-course={`Курс актерского мастерства ${centralCourse.studioName}`}
            >
              <span data-i18n="courses.enrollBtn">{t.enrollBtn}</span>
              <svg class="arrow shrink-0" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </button>
          </div>

        </div>

      </div>
    </div>

    <!-- ENROLLMENT FORM MODAL -->
    <div id="enrollment-modal" class="fixed inset-0 z-50 bg-granite/80 backdrop-blur-sm hidden items-center justify-center p-4 transition-all duration-300">
      <div class="bg-snow w-full max-w-lg rounded-3xl p-6 sm:p-10 border border-rule shadow-2xl relative transform transition-all max-h-[90vh] overflow-y-auto">
        
        <button id="modal-close" class="absolute top-6 right-6 w-10 h-10 rounded-full border border-rule text-mute hover:text-granite hover:bg-snow2 flex items-center justify-center text-xl transition">
          ✕
        </button>

        <span class="suomi-tag block mb-3" data-i18n="courses.centralCourse.badge">{centralCourse.badge}</span>
        <h3 class="font-nordic font-bold text-2xl text-granite mb-1" data-i18n="courses.centralCourse.trialInfo">{centralCourse.trialInfo}</h3>
        <p id="modal-course-name" class="font-sans font-semibold text-suomi text-base mb-6">{centralCourse.title}</p>

        <form id="enrollment-form" class="space-y-4" onsubmit="event.preventDefault(); handleFormSubmit();">
          <div>
            <label class="block font-sans text-[10px] uppercase tracking-wider text-mute mb-1">Имя</label>
            <input type="text" required placeholder="Ваше имя" class="w-full bg-snow2 border border-rule rounded-xl px-4 py-3 text-granite focus:outline-none focus:border-suomi font-sans text-sm" />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block font-sans text-[10px] uppercase tracking-wider text-mute mb-1">Телефон / WhatsApp</label>
              <input type="text" required placeholder="+358..." class="w-full bg-snow2 border border-rule rounded-xl px-4 py-3 text-granite focus:outline-none focus:border-suomi font-sans text-sm" />
            </div>
            <div>
              <label class="block font-sans text-[10px] uppercase tracking-wider text-mute mb-1">Email</label>
              <input type="email" required placeholder="name@domain.fi" class="w-full bg-snow2 border border-rule rounded-xl px-4 py-3 text-granite focus:outline-none focus:border-suomi font-sans text-sm" />
            </div>
          </div>

          <div>
            <label class="block font-sans text-[10px] uppercase tracking-wider text-mute mb-1">Комментарий</label>
            <textarea rows="3" placeholder="Вопросы или пожелания..." class="w-full bg-snow2 border border-rule rounded-xl px-4 py-3 text-granite focus:outline-none focus:border-suomi font-sans text-sm"></textarea>
          </div>

          <div class="pt-2">
            <button type="submit" class="w-full btn-suomi font-nordic text-xs uppercase tracking-wider font-semibold py-4 rounded-full shadow-lg" data-i18n="courses.enrollBtn">
              {t.enrollBtn}
            </button>
          </div>
        </form>

        <div id="form-success-message" class="hidden text-center py-8">
          <span class="w-16 h-16 bg-suomisoft text-suomi rounded-full inline-flex items-center justify-center text-3xl font-bold mb-4">✓</span>
          <h4 class="font-nordic font-bold text-2xl text-granite mb-2">Заявка принята!</h4>
          <p class="text-xs text-mute font-sans mb-4">Мы свяжемся с вами для подтверждения первого бесплатного занятия.</p>
          <button id="success-close" class="btn-outline font-nordic text-xs uppercase tracking-wider px-6 py-2.5 rounded-full mt-2">Закрыть</button>
        </div>

      </div>
    </div>

    <!-- LIGHTBOX PHOTO MODAL -->
    <div id="lightbox-modal" class="fixed inset-0 z-50 bg-granite/90 backdrop-blur-md hidden items-center justify-center p-4">
      <button id="lightbox-close" class="absolute top-6 right-6 text-white text-3xl hover:text-suomisoft transition">✕</button>
      <div class="max-w-4xl max-h-[85vh] relative">
        <img id="lightbox-img" src="" alt="Zoom Photo" class="max-w-full max-h-[80vh] rounded-2xl object-contain shadow-2xl border border-white/20" />
        <p id="lightbox-caption" class="text-center text-white font-nordic text-sm mt-4 tracking-wider"></p>
      </div>
    </div>

  </div>
</section>

<!-- CAROUSEL SCRIPT -->
<script>
  import { getCourseSlides } from '../data/courses';
  import { translations, type Language } from '../data/translations';

  function initCoursesCarousel() {
    let currentLang: Language = (localStorage.getItem('logrus_lang') as Language) || 'ru';
    let currentSlides = getCourseSlides(currentLang);
    let currentIndex = 0;

    const showcaseImg = document.getElementById('showcase-img') as HTMLImageElement;
    const showcaseTag = document.getElementById('showcase-tag');
    const showcaseLocation = document.getElementById('showcase-location');
    const showcaseTitle = document.getElementById('showcase-title');
    const showcaseSubtitle = document.getElementById('showcase-subtitle');
    const showcaseQuote = document.getElementById('showcase-quote');
    const currentNumEl = document.getElementById('slider-current-num');
    const progressEl = document.getElementById('slider-progress');
    const showcaseZoomBtn = document.getElementById('showcase-zoom-btn');
    const prevBtn = document.getElementById('slider-prev');
    const nextBtn = document.getElementById('slider-next');
    const thumbItems = Array.from(document.querySelectorAll('.thumb-item'));
    const mainShowcaseBox = document.getElementById('main-showcase-box');

    if (!showcaseImg) return;

    function goToSlide(index: number) {
      currentSlides = getCourseSlides(currentLang);
      const totalSlides = currentSlides.length;
      currentIndex = (index + totalSlides) % totalSlides;
      const data = currentSlides[currentIndex];

      showcaseImg.style.opacity = '0.3';
      showcaseImg.style.transform = 'scale(0.98)';

      setTimeout(() => {
        showcaseImg.src = data.image;
        showcaseImg.alt = data.title;
        if (showcaseTag) showcaseTag.textContent = data.tag;
        if (showcaseLocation) showcaseLocation.textContent = data.location;
        if (showcaseTitle) showcaseTitle.textContent = data.title;
        if (showcaseSubtitle) showcaseSubtitle.textContent = data.subtitle;
        if (showcaseQuote) showcaseQuote.textContent = `«${data.quote}»`;
        if (currentNumEl) currentNumEl.textContent = `0${currentIndex + 1}`;
        if (progressEl) progressEl.style.width = `${((currentIndex + 1) / totalSlides) * 100}%`;

        showcaseImg.style.opacity = '1';
        showcaseImg.style.transform = 'scale(1)';
      }, 180);

      thumbItems.forEach((item, idx) => {
        if (idx === currentIndex) {
          item.classList.add('border-suomi', 'scale-105');
          item.classList.remove('border-transparent');
        } else {
          item.classList.remove('border-suomi', 'scale-105');
          item.classList.add('border-transparent');
        }
      });
    }

    window.addEventListener('languageChange', ((e: CustomEvent) => {
      currentLang = e.detail.lang;
      goToSlide(currentIndex);
    }) as EventListener);

    prevBtn?.addEventListener('click', () => goToSlide(currentIndex - 1));
    nextBtn?.addEventListener('click', () => goToSlide(currentIndex + 1));

    thumbItems.forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = parseInt(btn.getAttribute('data-index') || '0', 10);
        goToSlide(idx);
      });
    });

    // Touch Swipe on Main Showcase Box
    let touchStartX = 0;
    let touchEndX = 0;

    mainShowcaseBox?.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    mainShowcaseBox?.addEventListener('touchend', (e) => {
      touchEndX = e.changedTouches[0].screenX;
      if (touchStartX - touchEndX > 40) {
        goToSlide(currentIndex + 1);
      } else if (touchEndX - touchStartX > 40) {
        goToSlide(currentIndex - 1);
      }
    }, { passive: true });

    // Lightbox modal logic
    const lightbox = document.getElementById('lightbox-modal');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
    const lightboxCaption = document.getElementById('lightbox-caption');
    const lightboxClose = document.getElementById('lightbox-close');

    showcaseZoomBtn?.addEventListener('click', () => {
      const data = currentSlides[currentIndex];
      if (lightbox && lightboxImg) {
        lightboxImg.src = data.image;
        if (lightboxCaption) lightboxCaption.textContent = `${data.tag} — ${data.title}`;
        lightbox.classList.remove('hidden');
        lightbox.classList.add('flex');
      }
    });

    lightboxClose?.addEventListener('click', () => {
      lightbox?.classList.add('hidden');
      lightbox?.classList.remove('flex');
    });

    lightbox?.addEventListener('click', (e) => {
      if (e.target === lightbox) {
        lightbox.classList.add('hidden');
        lightbox.classList.remove('flex');
      }
    });

    // Modal enrollment logic
    const modal = document.getElementById('enrollment-modal');
    const modalClose = document.getElementById('modal-close');
    const successClose = document.getElementById('success-close');
    const courseNameEl = document.getElementById('modal-course-name');
    const enrollBtns = document.querySelectorAll('.enroll-trigger-btn');
    const form = document.getElementById('enrollment-form') as HTMLFormElement;
    const successMsg = document.getElementById('form-success-message');

    enrollBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const courseName = btn.getAttribute('data-course') || 'Курс актерского мастерства';
        if (courseNameEl) courseNameEl.textContent = courseName;
        if (form) form.classList.remove('hidden');
        if (successMsg) successMsg.classList.add('hidden');
        modal?.classList.remove('hidden');
        modal?.classList.add('flex');
      });
    });

    modalClose?.addEventListener('click', () => {
      modal?.classList.add('hidden');
      modal?.classList.remove('flex');
    });

    successClose?.addEventListener('click', () => {
      modal?.classList.add('hidden');
      modal?.classList.remove('flex');
    });

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }
    });

    goToSlide(0);
  }

  (window as any).handleFormSubmit = function() {
    const form = document.getElementById('enrollment-form');
    const successMsg = document.getElementById('form-success-message');
    if (form && successMsg) {
      form.classList.add('hidden');
      successMsg.classList.remove('hidden');
    }
  };

  document.addEventListener('DOMContentLoaded', initCoursesCarousel);
</script>
