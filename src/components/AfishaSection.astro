---
import { shows } from '../data/shows';

const featuredShow = shows.find(s => s.isFeatured) || shows[0];
const secondaryShows = shows.filter(s => !s.isFeatured);
---

<section id="afisha" class="px-3 sm:px-10 py-16 sm:py-32">
  <div class="max-w-[1400px] mx-auto">

    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12 sm:mb-20 reveal">
      <div>
        <span class="suomi-tag mb-3">Ожидаемые показы // Октябрь 2026</span>
        <h2 class="font-nordic font-extrabold text-granite text-3xl sm:text-6xl lg:text-7xl leading-none mt-2">
          Репертуар<span class="font-dramatic italic font-normal text-suomi">.</span>
        </h2>
      </div>
      <p class="font-sans text-xs uppercase tracking-[0.2em] text-mute max-w-xs border-l-2 border-suomi pl-4 py-1">
        Субтитры на финском языке (suomenkieliset тексты)
      </p>
    </div>

    <!-- FEATURED SHOW -->
    <article class="reveal mb-12 sm:mb-20 p-4 sm:p-12 rounded-2xl sm:rounded-3xl bg-snow2/60 border border-rule">
      <div class="grid lg:grid-cols-12 gap-10 items-center">

        <div class="lg:col-span-5 relative group overflow-hidden rounded-2xl">
          <div class="aspect-[3/4] overflow-hidden">
            <img src={featuredShow.poster} alt={featuredShow.title} class="poster w-full h-full object-cover" />
          </div>
          <div class="absolute top-4 left-4 bg-suomi text-white font-nordic text-[10px] uppercase tracking-[0.2em] px-3.5 py-1.5 rounded-full font-semibold">
            Премьера в Хельсинки
          </div>
          <div class="absolute top-4 right-4 bg-redru text-white w-2.5 h-2.5 rounded-full"></div>
        </div>

        <div class="lg:col-span-7">
          <div class="flex flex-wrap items-center gap-3 mb-4">
            <span class="font-sans text-xs tracking-[0.2em] uppercase text-suomi font-bold">{featuredShow.date} · {featuredShow.stage}</span>
            <span class="w-1.5 h-1.5 rounded-full bg-redru"></span>
            <span class="font-sans text-xs uppercase tracking-[0.2em] text-mute">{featuredShow.time} · {featuredShow.capacity}</span>
          </div>

          <h3 class="font-nordic font-bold text-granite text-3xl sm:text-5xl lg:text-6xl mb-3 tracking-tight">
            {featuredShow.title.split(' ')[0]} <span class="font-dramatic italic font-normal text-suomi">{featuredShow.title.split(' ').slice(1).join(' ')}.</span>
          </h3>
          <p class="font-dramatic italic text-mute text-xl sm:text-2xl mb-6 sm:mb-8">{featuredShow.subtitle}</p>

          {featuredShow.quote && (
            <blockquote class="pl-4 sm:pl-6 my-6 border-l-2 border-redru py-1 bg-white/60 p-4 rounded-r-xl">
              <p class="font-dramatic italic text-xl sm:text-2xl text-granite leading-snug">
                {featuredShow.quote}
              </p>
            </blockquote>
          )}

          <p class="dropcap text-granite/80 text-base sm:text-lg leading-relaxed mb-8 max-w-2xl font-light">
            {featuredShow.description}
          </p>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 py-5 border-y border-rule mb-8">
            <div>
              <p class="font-sans text-[10px] uppercase tracking-[0.2em] text-suomi mb-1">Время</p>
              <p class="font-nordic font-bold text-base sm:text-lg text-granite">{featuredShow.duration}</p>
            </div>
            <div>
              <p class="font-sans text-[10px] uppercase tracking-[0.2em] text-suomi mb-1">Субтитры</p>
              <p class="font-nordic font-bold text-base sm:text-lg text-granite">{featuredShow.subtitles}</p>
            </div>
            <div>
              <p class="font-sans text-[10px] uppercase tracking-[0.2em] text-suomi mb-1">Возраст</p>
              <p class="font-nordic font-bold text-base sm:text-lg text-granite">{featuredShow.age}</p>
            </div>
            <div>
              <p class="font-sans text-[10px] uppercase tracking-[0.2em] text-suomi mb-1">Билеты</p>
              <p class="font-nordic font-bold text-base sm:text-lg text-suomi">{featuredShow.price}</p>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4">
            <button class="btn-suomi font-nordic text-xs tracking-wider uppercase font-semibold px-5 sm:px-8 py-3.5 sm:py-4 rounded-full inline-flex items-center justify-center gap-3 group">
              Забронировать билет ({featuredShow.price})
              <svg class="arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </button>
            <a href="#" class="btn-outline font-nordic text-xs tracking-wider uppercase font-semibold px-5 sm:px-7 py-3.5 sm:py-4 rounded-full text-center">О спектакле</a>
          </div>
        </div>

      </div>
    </article>

    <!-- SECONDARY SHOWS -->
    <div class="space-y-8">
      {secondaryShows.map((show) => (
        <article class="reveal rounded-3xl border border-rule overflow-hidden bg-snow flex flex-col md:flex-row items-stretch">
          <div class="md:w-5/12 relative aspect-[16/10] md:aspect-auto overflow-hidden">
            <img src={show.poster} alt={show.title} class="poster absolute inset-0 w-full h-full object-cover" />
          </div>
          <div class="md:w-7/12 p-4 sm:p-12 flex flex-col justify-between">
            <div>
              <div class="flex items-center gap-3 mb-3">
                <span class="font-sans text-xs tracking-[0.2em] uppercase text-suomi font-bold">{show.date} · {show.time}</span>
                <span class="w-1.5 h-1.5 rounded-full bg-rule"></span>
                <span class="font-sans text-xs uppercase tracking-[0.2em] text-mute">{show.stage}</span>
              </div>
              <h3 class="font-nordic font-bold text-granite text-2xl sm:text-4xl mb-2">{show.title}</h3>
              <p class="font-dramatic italic text-mute text-xl mb-4">{show.subtitle}</p>
              <p class="text-granite/80 text-base leading-relaxed max-w-xl font-light mb-6">
                {show.description}
              </p>
            </div>
            <div class="flex items-center justify-between border-t border-rule pt-6 mt-4">
              <div>
                <p class="font-sans text-[10px] uppercase tracking-[0.2em] text-mute">Цена</p>
                <p class="font-nordic font-bold text-xl text-granite">{show.price}</p>
              </div>
              <button class="btn-suomi font-nordic text-xs tracking-wider uppercase font-semibold px-6 py-3 rounded-full inline-flex items-center gap-2 group">
                Билеты <svg class="arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </button>
            </div>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>
