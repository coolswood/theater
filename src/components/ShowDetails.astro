---
import type { Show } from "../data/shows";
import { translations } from "../data/translations";

interface Props {
  show: Show;
}

const { show } = Astro.props;
const t = translations.ru.showPage;

function getInitials(name: string) {
  return name
    .split(/[\s&,]+/)
    .filter(Boolean)
    .map((part) => part.charAt(0))
    .slice(0, 2)
    .join('');
}
---

<section
  id="details"
  class="px-3 sm:px-10 py-16 sm:py-28 border-t border-rule bg-snow"
>
  <div class="max-w-[1400px] mx-auto space-y-12 sm:space-y-16">
    <!-- Section Header -->
    <div class="reveal max-w-3xl">
      <span class="suomi-tag mb-3" data-i18n="showPage.castSectionTitle">{t.castSectionTitle}</span>
      <h2
        class="font-nordic font-extrabold text-granite text-3xl sm:text-5xl mb-4 tracking-tight"
      >
        <span data-i18n="showPage.castSectionTitle">{t.castSectionTitle}</span><span class="text-suomi font-extrabold">.</span>
      </h2>
      <p
        class="font-sans font-light text-mute text-base sm:text-lg leading-relaxed"
        data-i18n="showPage.scandinavianAestheticText"
      >
        {t.scandinavianAestheticText}
      </p>
    </div>

    <!-- Director's Vision Card -->
    {
      show.director && (
        <div class="reveal p-6 sm:p-10 rounded-3xl bg-white border border-rule shadow-xs flex flex-col justify-between relative overflow-hidden group hover:border-suomi/30 transition-all duration-300">
          <div class="absolute -top-3 -right-2 text-7xl sm:text-8xl font-nordic text-suomi/5 font-black select-none pointer-events-none leading-none">
            ”
          </div>
          <div class="relative z-10">
            <span
              class="font-sans text-[10px] font-bold uppercase tracking-[0.25em] text-suomi block mb-4"
              data-i18n="showPage.directorSectionTitle"
            >
              {t.directorSectionTitle}
            </span>
            <blockquote class="font-sans italic text-base sm:text-xl text-granite leading-relaxed mb-6 max-w-4xl">
              {show.director.quote}
            </blockquote>
          </div>
          <div class="relative z-10 flex items-center gap-3.5 pt-4 border-t border-rule/70">
            <div class="w-12 h-12 rounded-full bg-gradient-to-br from-suomi to-suomidark text-white font-nordic font-bold flex items-center justify-center text-sm shadow-xs shrink-0">
              {getInitials(show.director.name)}
            </div>
            <div>
              <p class="font-nordic font-bold text-base text-granite">
                {show.director.name}
              </p>
              <p class="font-sans text-xs sm:text-sm text-mute">
                {show.director.role}
              </p>
            </div>
          </div>
        </div>
      )
    }

    <!-- Cast & Crew Grid -->
    <div class="reveal">
      <div class="flex items-center justify-between mb-6">
        <h3
          class="font-nordic font-bold text-xl sm:text-2xl text-granite flex items-center gap-2.5"
          data-i18n="showPage.castSectionTitle"
        >
          <span>{t.castSectionTitle}</span>
          <span class="w-2 h-2 rounded-full bg-suomi"></span>
        </h3>
      </div>

      {
        show.cast && show.cast.length > 0 ? (
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
            {show.cast.map((member) => (
              <div class="p-5 sm:p-6 rounded-2xl sm:rounded-3xl bg-white border border-rule shadow-xs hover:shadow-md hover:border-suomi/40 transition-all duration-300 group flex flex-col justify-between">
                <div class="flex items-start gap-3.5 mb-3">
                  <div class="w-10 h-10 rounded-full bg-suomisoft/80 border border-suomi/20 text-suomi font-nordic font-bold text-xs flex items-center justify-center shrink-0 group-hover:bg-suomi group-hover:text-white transition-colors duration-300">
                    {getInitials(member.name)}
                  </div>
                  <div>
                    <h4 class="font-nordic font-bold text-sm sm:text-base text-granite group-hover:text-suomi transition-colors leading-snug">
                      {member.name}
                    </h4>
                  </div>
                </div>
                <p class="font-sans text-xs text-mute leading-relaxed pl-13.5">
                  {member.role}
                </p>
              </div>
            ))}
          </div>
        ) : (
          <div class="p-8 rounded-3xl bg-white border border-rule text-center">
            <p class="text-sm text-mute font-sans">
              Информация о составе обновляется.
            </p>
          </div>
        )
      }
    </div>
  </div>
</section>
