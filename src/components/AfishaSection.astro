---
import { getActiveShows, getFeaturedShow } from "../data/shows";
import { translations } from "../data/translations";
import RehearsalPlaceholder from "./RehearsalPlaceholder.astro";

const t = translations.ru.afisha;
const shows = getActiveShows("ru");
const featuredShow = getFeaturedShow("ru");
const secondaryShows = featuredShow ? shows.filter((s) => s.id !== featuredShow.id) : [];
---

<section id="afisha" class="px-3 sm:px-10 py-16 sm:py-32">
  <div class="max-w-[1400px] mx-auto">
    {
      featuredShow ? (
        <>
          <div
            class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12 sm:mb-20 reveal"
          >
            <div>
              <span class="suomi-tag mb-3" data-i18n="afisha.tag">{t.tag}</span>
              <h2
                class="font-nordic font-extrabold text-granite text-3xl sm:text-6xl lg:text-7xl leading-none mt-2"
                data-i18n-html="afisha.title"
                set:html={t.title}
              />
            </div>
            <p
              class="font-sans text-xs uppercase tracking-[0.2em] text-mute max-w-xs border-l-2 border-suomi pl-4 py-1"
              data-i18n="afisha.subtitlesNote"
            >
              {t.subtitlesNote}
            </p>
          </div>
          {/* FEATURED ACTIVE SHOW */}
          <article
            class="reveal p-4 sm:p-12 rounded-2xl sm:rounded-3xl bg-snow2/60 border border-rule"
          >
            <div class="grid lg:grid-cols-12 gap-10 items-center">
              <div
                class="lg:col-span-5 relative group overflow-hidden rounded-2xl flex items-center justify-center bg-granite/5 p-2 sm:p-4"
              >
                <img
                  src={featuredShow.poster}
                  alt={featuredShow.title}
                  class="poster w-full h-auto max-h-[75vh] object-contain rounded-xl shadow-sm"
                />
              </div>

              <div class="lg:col-span-7">
                <div class="flex flex-wrap items-center gap-2.5 sm:gap-3 mb-5">
                  <span
                    class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-suomi text-white font-sans text-xs sm:text-sm font-semibold shadow-xs"
                  >
                    <svg class="w-4 h-4 text-white/90 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                    <span data-i18n={`afisha.shows.${featuredShow.id}.date`}>{featuredShow.date}</span>
                    <span>· {featuredShow.time}</span>
                  </span>

                  <span
                    class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white text-granite font-sans text-xs sm:text-sm font-semibold border border-rule shadow-xs"
                  >
                    <svg class="w-4 h-4 text-redru shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    <span data-i18n={`afisha.shows.${featuredShow.id}.stage`}>{featuredShow.stage}</span>
                  </span>

                  <a
                    href={`/shows/${featuredShow.id}#reviews`}
                    class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-white hover:bg-snow2 text-granite font-sans text-xs sm:text-sm font-semibold border border-rule shadow-xs transition hover:scale-105"
                  >
                    <svg class="w-3.5 h-3.5 text-suomi" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                    </svg>
                    <span class="text-granite/90" data-i18n="showPage.reviewsTag">Отзывы</span>
                  </a>
                </div>

                <h3
                  class="font-nordic font-bold text-granite text-3xl sm:text-5xl lg:text-6xl mb-3 tracking-tight"
                  data-i18n={`afisha.shows.${featuredShow.id}.title`}
                >
                  {featuredShow.title}
                </h3>
                <p
                  class="font-sans font-medium text-mute text-lg sm:text-xl mb-6 sm:mb-8"
                  data-i18n={`afisha.shows.${featuredShow.id}.subtitle`}
                >
                  {featuredShow.subtitle}
                </p>

                {
                  featuredShow.quote && (
                    <blockquote class="relative my-7 p-6 sm:p-8 rounded-2xl bg-gradient-to-br from-suomisoft/70 via-white to-snow2/50 border border-rule/80 shadow-xs overflow-hidden group transition-all duration-300 hover:border-suomi/30">
                      <div class="absolute -top-3 -left-2 text-6xl sm:text-7xl font-nordic text-suomi/10 font-black select-none pointer-events-none leading-none">
                        “
                      </div>
                      <div class="relative z-10">
                        <p
                          class="font-sans font-medium italic text-base sm:text-xl text-granite leading-relaxed tracking-tight"
                          data-i18n={`afisha.shows.${featuredShow.id}.quote`}
                        >
                          {featuredShow.quote}
                        </p>
                      </div>
                    </blockquote>
                  )
                }

                <p
                  class="dropcap text-granite/80 text-base sm:text-lg leading-relaxed mb-8 max-w-2xl font-light"
                  data-i18n={`afisha.shows.${featuredShow.id}.description`}
                >
                  {featuredShow.description}
                </p>

                <!-- Modern Quick Facts Cards Grid -->
                <div class="grid grid-cols-3 gap-3 sm:gap-3.5 mb-8">
                  <div
                    class="p-3.5 sm:p-4 rounded-2xl bg-birch/35 border border-rule/70 hover:border-suomi/30 transition flex flex-col justify-between space-y-1"
                  >
                    <span
                      class="font-sans text-[10px] uppercase tracking-[0.2em] text-suomi font-bold block"
                      data-i18n="afisha.durationLabel">{t.durationLabel}</span
                    >
                    <p
                      class="font-nordic font-bold text-sm sm:text-base text-granite"
                      data-i18n={`afisha.shows.${featuredShow.id}.duration`}
                    >
                      {featuredShow.duration}
                    </p>
                  </div>

                  <div
                    class="p-3.5 sm:p-4 rounded-2xl bg-birch/35 border border-rule/70 hover:border-suomi/30 transition flex flex-col justify-between space-y-1"
                  >
                    <span
                      class="font-sans text-[10px] uppercase tracking-[0.2em] text-suomi font-bold block"
                      data-i18n="afisha.subtitlesLabel">{t.subtitlesLabel}</span
                    >
                    <p
                      class="font-nordic font-bold text-sm sm:text-base text-granite"
                      data-i18n={`afisha.shows.${featuredShow.id}.subtitles`}
                    >
                      {featuredShow.subtitles}
                    </p>
                  </div>

                  <div
                    class="p-3.5 sm:p-4 rounded-2xl bg-birch/35 border border-rule/70 hover:border-suomi/30 transition flex flex-col justify-between space-y-1"
                  >
                    <span
                      class="font-sans text-[10px] uppercase tracking-[0.2em] text-suomi font-bold block"
                      data-i18n="afisha.ageLabel">{t.ageLabel}</span
                    >
                    <p
                      class="font-nordic font-bold text-sm sm:text-base text-granite"
                      data-i18n={`afisha.shows.${featuredShow.id}.age`}
                    >
                      {featuredShow.age}
                    </p>
                  </div>
                </div>

                <div
                  class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4"
                >
                  <a
                    href={featuredShow.fientaUrl ||
                      "https://fienta.com/ru/spektakl-novechento-chetverg-13-avgusta-19-00-21-00"}
                    target="_blank"
                    rel="noopener"
                    class="btn-suomi font-nordic text-xs tracking-wider uppercase font-semibold px-5 sm:px-8 py-3.5 sm:py-4 rounded-full inline-flex items-center justify-center gap-3 group"
                  >
                    <span data-i18n="afisha.bookTicketBtn">{t.bookTicketBtn}</span>
                    <svg
                      class="arrow"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"></path></svg
                    >
                  </a>
                  <a
                    href={`/shows/${featuredShow.id}`}
                    class="btn-outline font-nordic text-xs tracking-wider uppercase font-semibold px-5 sm:px-7 py-3.5 sm:py-4 rounded-full text-center"
                    data-i18n="afisha.aboutShowBtn">{t.aboutShowBtn}</a
                  >
                </div>
              </div>
            </div>
          </article>

          {/* SECONDARY ACTIVE SHOWS */}
          {
            secondaryShows.length > 0 && (
              <div class="space-y-8 mt-8 sm:mt-12">
                {secondaryShows.map((show) => (
                  <article class="reveal rounded-3xl border border-rule overflow-hidden bg-snow flex flex-col md:flex-row items-stretch">
                    <div class="md:w-5/12 relative flex items-center justify-center p-3 bg-granite/5 min-h-[260px]">
                      <img
                        src={show.poster}
                        alt={show.title}
                        class="poster w-full h-auto max-h-[400px] object-contain rounded-xl"
                      />
                    </div>
                    <div class="md:w-7/12 p-4 sm:p-12 flex flex-col justify-between">
                      <div>
                        <div class="flex flex-wrap items-center gap-2 sm:gap-2.5 mb-4">
                          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-suomi text-white font-sans text-xs font-semibold shadow-xs">
                            <svg class="w-3.5 h-3.5 text-white/90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>
                            <span data-i18n={`afisha.shows.${show.id}.date`}>
                              {show.date}
                            </span>
                            <span>· {show.time}</span>
                          </span>
                          <span
                            class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white text-granite font-sans text-xs font-semibold border border-rule shadow-xs"
                          >
                            <svg class="w-3.5 h-3.5 text-redru shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                            <span data-i18n={`afisha.shows.${show.id}.stage`}>{show.stage}</span>
                          </span>
                        </div>
                        <h3
                          class="font-nordic font-bold text-granite text-2xl sm:text-4xl mb-2"
                          data-i18n={`afisha.shows.${show.id}.title`}
                        >
                          {show.title}
                        </h3>
                        <p
                          class="font-sans font-medium text-mute text-base sm:text-lg mb-4"
                          data-i18n={`afisha.shows.${show.id}.subtitle`}
                        >
                          {show.subtitle}
                        </p>
                        <p
                          class="text-granite/80 text-base leading-relaxed max-w-xl font-light mb-6"
                          data-i18n={`afisha.shows.${show.id}.description`}
                        >
                          {show.description}
                        </p>
                      </div>
                      <div class="flex flex-wrap items-center justify-end gap-3 border-t border-rule pt-6 mt-4">
                        <a
                          href={`/shows/${show.id}`}
                          class="btn-outline font-nordic text-xs tracking-wider uppercase font-semibold px-5 py-3 rounded-full text-center"
                          data-i18n="afisha.aboutShowBtn"
                        >
                          {t.aboutShowBtn}
                        </a>
                        <a
                          href={
                            show.fientaUrl ||
                            "https://fienta.com/ru/spektakl-novechento-chetverg-13-avgusta-19-00-21-00"
                          }
                          target="_blank"
                          rel="noopener"
                          class="btn-suomi font-nordic text-xs tracking-wider uppercase font-semibold px-6 py-3 rounded-full inline-flex items-center gap-2 group"
                        >
                          <span data-i18n="afisha.secondaryBuyBtn">
                            {t.secondaryBuyBtn}
                          </span>{" "}
                          <svg
                            class="arrow"
                            width="14"
                            height="14"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                          >
                            <path d="M5 12h14M13 6l6 6-6 6" />
                          </svg>
                        </a>
                      </div>
                    </div>
                  </article>
                ))}
              </div>
            )
          }
        </>
      ) : (
        <RehearsalPlaceholder />
      )
    }
  </div>
</section>

