<section id="top" class="relative px-6 sm:px-10 pt-16 sm:pt-24 pb-24 border-b border-rule bg-nordic-grid">
  <div class="max-w-[1400px] mx-auto">

    <div class="flex flex-wrap items-center gap-4 mb-8 reveal">
      <span class="suomi-tag font-semibold">Финляндия · Хельсинки</span>
      <span class="text-rule">/</span>
      <span class="font-mono text-xs uppercase tracking-[0.2em] text-mute flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-redru inline-block"></span>
        Русскоязычная камерная сцена
      </span>
    </div>

    <h1 class="font-nordic font-semibold text-granite leading-[1.08] text-[9vw] sm:text-[7.5vw] lg:text-[6.5rem] tracking-tight reveal">
      Русская драма<br />
      в северной <span class="font-dramatic italic font-normal text-suomi">тишине</span><span class="text-redru">.</span>
    </h1>

    <div class="grid lg:grid-cols-12 gap-10 lg:gap-16 mt-16 reveal items-end">
      <div class="lg:col-span-7">
        <p class="text-xl sm:text-2xl text-granite/90 leading-relaxed font-light max-w-2xl">
          <span class="font-dramatic italic text-suomi text-3xl font-semibold">Logrus Teatteri</span> — прохладная скандинавская эстетика пространства в центре Хельсинки и глубокое уважение к русской драматической традиции.
        </p>
      </div>

      <div class="lg:col-span-5 lg:border-l lg:border-rule lg:pl-10">
        <div class="p-6 rounded-2xl bg-suomisoft/40 border border-rule">
          <p class="font-mono text-[11px] uppercase tracking-[0.25em] text-suomi mb-3 font-semibold">— Наша локация —</p>
          <p class="font-nordic font-bold text-lg text-granite mb-1">Helsinki · Kamppi</p>
          <p class="font-serif italic text-base text-mute">Камерный зал на 90 мест в районе Камппи</p>
          <div class="mt-4 pt-4 border-t border-rule/60 flex items-center justify-between text-xs font-mono">
            <span class="text-mute uppercase tracking-wider">Язык спектаклей</span>
            <span class="text-granite font-semibold">Русский (с финскими субтитрами)</span>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>
