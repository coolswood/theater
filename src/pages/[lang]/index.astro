---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import AfishaSection from '../../components/AfishaSection.astro';
import CoursesSection from '../../components/CoursesSection.astro';
import AboutSection from '../../components/AboutSection.astro';
import ContactSection from '../../components/ContactSection.astro';
import Footer from '../../components/Footer.astro';
import { getActiveShows } from '../../data/shows';
import type { Language } from '../../data/translations';
import {
  getHomePageMeta,
  getOrganizationSchema,
  getWebSiteSchema,
  getCourseSchema,
  getEventsListSchema
} from '../../utils/seo';

export function getStaticPaths() {
  return [
    { params: { lang: 'fi' } },
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params as { lang: Language };
const activeShows = getActiveShows(lang);
const meta = getHomePageMeta(lang);
const homeSchemas = [
  getOrganizationSchema(lang),
  getWebSiteSchema(lang),
  getCourseSchema(lang),
  ...(activeShows.length > 0 ? [getEventsListSchema(activeShows, lang)] : [])
];
---

<Layout
  lang={lang}
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  schema={homeSchemas}
>
  <Header lang={lang} />
  <main transition:animate="fade">
    <Hero lang={lang} />
    <AfishaSection lang={lang} />
    <CoursesSection lang={lang} />
    <AboutSection lang={lang} />
    <ContactSection lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
