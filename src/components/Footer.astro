---
import { translations, type Language } from "../data/translations";

interface Props {
  lang?: Language;
}

const { lang = "ru" } = Astro.props;
const t = translations[lang]?.footer || translations.ru.footer;
---

<footer class="border-t border-rule py-8 sm:py-12 bg-snow2/30">
  <div
    class="max-w-[1400px] mx-auto px-3 sm:px-10 flex flex-col sm:flex-row items-center justify-between gap-6"
  >
    <div
      class="font-nordic text-lg font-bold tracking-tight text-granite flex items-center gap-2.5"
    >
      <img
        src="/logo-96.webp"
        alt="Logrus Logo"
        class="h-8 w-8 object-contain shrink-0"
        width="32"
        height="32"
        loading="lazy"
        decoding="async"
      />
      Logrus Teatteri
    </div>
    <p
      class="font-sans text-mute text-xs text-center sm:text-left"
      data-i18n="footer.copyright"
    >
      {t.copyright}
    </p>
    <a
      href="#top"
      class="font-sans text-mute hover:text-suomi text-xs uppercase tracking-[0.2em] transition"
      data-i18n="footer.toTop">{t.toTop}</a
    >
  </div>
</footer>
