<section id="about" class="px-6 sm:px-10 py-24 sm:py-32 border-t border-rule bg-suomisoft/30">
  <div class="max-w-[1400px] mx-auto">

    <div class="grid lg:grid-cols-12 gap-12 mb-20">
      <div class="lg:col-span-7 reveal">
        <span class="suomi-tag block mb-4">Наша миссия</span>
