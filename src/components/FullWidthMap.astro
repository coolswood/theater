---
import { translations } from '../data/translations';
const t = translations.ru.contacts;
const showPageT = translations.ru.showPage;
---

<section id="fullwidth-map" class="relative w-full py-12 sm:py-24 border-t border-rule bg-snow overflow-hidden">
  
  <!-- Section Title Container -->
  <div class="max-w-[1400px] mx-auto px-3 sm:px-10 mb-8 reveal">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
      <div>
        <span class="suomi-tag mb-2" data-i18n="contacts.mapTag">{t.mapTag}</span>
        <h2 class="font-nordic font-extrabold text-granite text-2xl sm:text-5xl" data-i18n="showPage.mapHeading">{showPageT.mapHeading}</h2>
      </div>
      <p class="text-xs sm:text-sm text-mute font-sans max-w-sm">
        Urho Kekkosen katu 8, Kamppi, Helsinki
      </p>
    </div>
  </div>

  <!-- FULL WIDTH MAP WRAPPER (100vw stretch) -->
  <div class="w-full relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] w-screen border-y border-rule shadow-sm bg-snow2 min-h-[500px] sm:min-h-[620px] flex flex-col justify-between">
    
    <!-- Leaflet Map CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

    <!-- Top Overlay Control Bar -->
    <div class="p-4 sm:p-6 bg-white/90 backdrop-blur-md z-10 border-b border-rule flex flex-wrap items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <span class="w-3 h-3 rounded-full bg-suomi animate-pulse"></span>
        <div>
          <p class="font-nordic font-bold text-base sm:text-lg text-granite" data-i18n="contacts.mapTitle">{t.mapTitle}</p>
          <p class="font-sans text-xs text-mute hidden sm:block">Logrus Teatteri · Kamppi Chamber Hall</p>
        </div>
      </div>

      <!-- Quick Preset Navigation Buttons -->
      <div class="flex items-center gap-2 bg-snow2 p-1.5 rounded-2xl text-xs font-sans border border-rule">
        <button id="fullmap-btn-theater" class="px-3.5 py-1.5 rounded-xl bg-suomi text-white font-semibold transition cursor-pointer shadow-xs" data-i18n="contacts.btnStage">
          {t.btnStage}
        </button>
        <button id="fullmap-btn-kamppi" class="px-3.5 py-1.5 rounded-xl text-granite/70 hover:text-granite hover:bg-white transition cursor-pointer" data-i18n="contacts.btnKamppi">
          {t.btnKamppi}
        </button>
        <button id="fullmap-btn-station" class="px-3.5 py-1.5 rounded-xl text-granite/70 hover:text-granite hover:bg-white transition cursor-pointer" data-i18n="contacts.btnStation">
          {t.btnStation}
        </button>
      </div>
    </div>

    <!-- Leaflet Canvas Element -->
    <div id="fullwidth-interactive-map" class="w-full h-full min-h-[380px] sm:min-h-[480px] flex-1 z-0 relative"></div>

    <!-- Bottom Overlay Route Bar -->
    <div class="p-4 sm:p-6 bg-white/95 backdrop-blur-md border-t border-rule z-10 flex flex-wrap items-center justify-between gap-4">
      <div class="text-xs sm:text-sm text-granite font-medium flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-full bg-suomisoft text-suomi flex items-center justify-center shrink-0">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
        </div>
        <span data-i18n-html="contacts.locationText" set:html={t.locationText} />
      </div>

      <div class="flex items-center gap-3 w-full sm:w-auto">
        <a 
          href="https://maps.google.com/?q=Urho+Kekkosen+katu+8,+Helsinki" 
          target="_blank" 
          rel="noopener noreferrer"
          class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-2 bg-suomi hover:bg-suomidark text-white text-xs font-nordic font-semibold px-5 py-3 rounded-full transition shadow-md hover:shadow-suomi/30"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/></svg>
          Google Maps
        </a>
        <a 
          href="https://reittiopas.hsl.fi/haku/Urho%20Kekkosen%20katu%208%2C%20Helsinki" 
          target="_blank" 
          rel="noopener noreferrer"
          class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-2 bg-snow2 hover:bg-rule text-granite text-xs font-nordic font-semibold px-5 py-3 rounded-full transition border border-rule"
        >
          <span data-i18n="contacts.hslRoute">{t.hslRoute}</span>
        </a>
      </div>
    </div>

  </div>
</section>

<script>
  function initFullWidthTheaterMap() {
    const container = document.getElementById('fullwidth-interactive-map');
    if (!container) return;

    function runFullMapSetup() {
      const L = (window as any).L;
      if (!L || (window as any)._logrusFullMapInitialized) return;
      (window as any)._logrusFullMapInitialized = true;

      const theaterCoords: [number, number] = [60.16915, 24.93318];
      const kamppiCoords: [number, number] = [60.1689, 24.9315];
      const stationCoords: [number, number] = [60.1708, 24.9414];

      const map = L.map('fullwidth-interactive-map', {
        center: theaterCoords,
        zoom: 16,
        zoomControl: false,
        scrollWheelZoom: false
      });

      L.control.zoom({ position: 'topright' }).addTo(map);

      L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
        maxZoom: 19,
        subdomains: 'abcd',
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> &copy; <a href="https://carto.com/">CARTO</a>'
      }).addTo(map);

      const customIcon = L.divIcon({
        className: 'custom-full-map-pin',
        html: `
          <div style="position:relative; display:flex; align-items:center; justify-content:center; width:44px; height:44px;">
            <div style="position:absolute; width:44px; height:44px; border-radius:50%; background:rgba(0,53,128,0.25); animation:ping 1.6s cubic-bezier(0,0,0.2,1) infinite;"></div>
            <div style="position:relative; width:44px; height:44px; border-radius:50%; background:#003580; color:#fff; display:flex; align-items:center; justify-content:center; box-shadow:0 12px 20px -4px rgba(0,53,128,0.5); border:3px solid #fff; font-size:20px;">
              🎭
            </div>
          </div>
        `,
        iconSize: [44, 44],
        iconAnchor: [22, 22],
        popupAnchor: [0, -24]
      });

      const marker = L.marker(theaterCoords, { icon: customIcon }).addTo(map);

      const popupContent = `
        <div style="font-family: 'Plus Jakarta Sans', sans-serif; padding: 6px; color: #16191d; min-width: 180px;">
          <div style="font-weight: 800; font-size: 15px; margin-bottom: 2px; color: #003580;">Logrus Teatteri</div>
          <div style="font-size: 12px; color: #626b73; line-height: 1.4;">Urho Kekkosen katu 8, Helsinki</div>
          <div style="font-size: 11px; margin-top: 6px; font-weight: 700; color: #003580; background: #e8f0fe; padding: 4px 8px; border-radius: 6px; display: inline-block;">🚇 Kamppi Metro (2 min)</div>
        </div>
      `;
      marker.bindPopup(popupContent).openPopup();

      const kamppiIcon = L.divIcon({
        className: 'custom-subway-pin-full',
        html: `<div style="width:28px; height:28px; border-radius:50%; background:#f97316; color:#fff; font-size:12px; font-weight:bold; display:flex; align-items:center; justify-content:center; border:2px solid #fff; box-shadow:0 4px 8px rgba(0,0,0,0.2);">M</div>`,
        iconSize: [28, 28],
        iconAnchor: [14, 14]
      });
      L.marker(kamppiCoords, { icon: kamppiIcon }).addTo(map).bindPopup('<b>Kamppi Metro Station</b><br>Urho Kekkosen katu');

      const btnTheater = document.getElementById('fullmap-btn-theater');
      const btnKamppi = document.getElementById('fullmap-btn-kamppi');
      const btnStation = document.getElementById('fullmap-btn-station');

      function setActiveBtn(activeBtn: HTMLElement | null) {
        [btnTheater, btnKamppi, btnStation].forEach(btn => {
          if (!btn) return;
          if (btn === activeBtn) {
            btn.className = "px-3.5 py-1.5 rounded-xl bg-suomi text-white font-semibold transition cursor-pointer shadow-xs";
          } else {
            btn.className = "px-3.5 py-1.5 rounded-xl text-granite/70 hover:text-granite hover:bg-white transition cursor-pointer";
          }
        });
      }

      btnTheater?.addEventListener('click', () => {
        map.flyTo(theaterCoords, 17, { duration: 1.2 });
        marker.openPopup();
        setActiveBtn(btnTheater);
      });

      btnKamppi?.addEventListener('click', () => {
        map.flyTo(kamppiCoords, 17, { duration: 1.2 });
        setActiveBtn(btnKamppi);
      });

      btnStation?.addEventListener('click', () => {
        map.flyTo(stationCoords, 16, { duration: 1.2 });
        setActiveBtn(btnStation);
      });

      setTimeout(() => map.invalidateSize(), 350);
    }

    if (typeof (window as any).L === 'undefined') {
      const script = document.createElement('script');
      script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
      script.crossOrigin = '';
      script.onload = runFullMapSetup;
      document.head.appendChild(script);
    } else {
      runFullMapSetup();
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFullWidthTheaterMap);
  } else {
    initFullWidthTheaterMap();
  }
</script>
