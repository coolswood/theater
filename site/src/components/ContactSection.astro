---
---

<section id="contacts" class="px-6 sm:px-10 py-24 sm:py-32 border-t border-rule">
  <div class="max-w-[1400px] mx-auto">

    <h2 class="font-nordic font-extrabold text-granite text-4xl sm:text-6xl lg:text-7xl mb-16 reveal">
      Tervetuloa <span class="font-dramatic italic font-normal text-suomi">· Добро пожаловать.</span>
    </h2>

    <div class="grid md:grid-cols-12 gap-8 reveal">
      <div class="md:col-span-7 p-10 rounded-3xl border border-rule bg-snow2/40 flex flex-col justify-between">
        <div>
          <h3 class="font-nordic font-bold text-xl text-granite mb-8">Контакты и Касса</h3>
          <div class="grid sm:grid-cols-2 gap-8">
            <div>
              <p class="font-mono text-[10px] uppercase tracking-[0.25em] text-suomi mb-2 font-bold">Особые данные / Адрес</p>
              <p class="text-lg text-granite font-medium">Urho Kekkosen katu 8</p>
              <p class="text-sm text-mute mt-1">Helsinki, Kamppi · Finland</p>
            </div>
            <div>
              <p class="font-mono text-[10px] uppercase tracking-[0.25em] text-suomi mb-2 font-bold">Связь</p>
              <p class="text-lg text-granite font-medium">+358 9 123 4567</p>
              <p class="text-base text-mute">info@logrus.fi</p>
            </div>
          </div>
        </div>
        <div class="mt-10 pt-6 border-t border-rule">
          <p class="font-mono text-[10px] uppercase tracking-[0.25em] text-suomi mb-1 font-bold">Время работы кассы</p>
          <p class="text-base text-granite/80">Ср – Вс: 14:00 – 19:00 (в дни показов — до 20:30)</p>
        </div>
      </div>

      <div class="md:col-span-5 p-10 rounded-3xl bg-granite text-white flex flex-col justify-between">
        <div>
          <span class="suomi-tag text-white border-suomi block mb-3">Подписка</span>
          <h3 class="font-nordic font-bold text-2xl mb-3">Бюллетень сезонов</h3>
          <p class="text-white/70 mb-8 text-sm leading-relaxed font-light">
            Анонсы гастролей, новых премьер и билетов для постоянных зрителей в Финляндии.
          </p>
          <form class="space-y-3" onsubmit="event.preventDefault(); alert('Спасибо за подписку!');">
            <input type="email" placeholder="ваш@email.fi" required class="w-full bg-white/10 border border-white/20 rounded-full px-5 py-3.5 text-white placeholder-white/40 focus:outline-none focus:border-white/60 transition text-sm font-mono" />
            <button type="submit" class="w-full bg-suomi text-white font-nordic text-xs uppercase tracking-wider font-semibold py-3.5 rounded-full hover:bg-suomidark transition">Подписаться</button>
          </form>
        </div>
        <div class="flex gap-4 mt-8 font-mono text-xs uppercase tracking-[0.15em] text-white/60">
          <a href="#" class="hover:text-white transition">VK</a>
          <span>/</span>
          <a href="#" class="hover:text-white transition">Telegram</a>
          <span>/</span>
          <a href="#" class="hover:text-white transition">Instagram</a>
        </div>
      </div>
    </div>

  </div>
</section>
