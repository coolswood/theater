---
import { translations } from '../data/translations';
const t = translations.ru.hero;
---

<section id="top" class="relative px-3 sm:px-10 pt-12 sm:pt-24 pb-16 sm:pb-24 border-b border-rule bg-nordic-grid">
  <div class="max-w-[1400px] mx-auto">

    <div class="flex flex-wrap items-center gap-3 sm:gap-4 mb-6 sm:mb-8 reveal">
      <span class="suomi-tag font-semibold" data-i18n="hero.countryTag">{t.countryTag}</span>
      <span class="text-rule">/</span>
      <span class="font-sans text-xs uppercase tracking-[0.15em] sm:tracking-[0.2em] text-mute flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-redru inline-block"></span>
        <span data-i18n="hero.stageTag">{t.stageTag}</span>
      </span>
    </div>

    <h1 class="font-nordic font-semibold text-granite leading-[1.08] text-[8.5vw] sm:text-[7.5vw] lg:text-[6.5rem] tracking-tight reveal" data-i18n-html="hero.title" set:html={t.title} />

    <div class="grid lg:grid-cols-12 gap-8 lg:gap-16 mt-12 sm:mt-16 reveal items-end">
      <div class="lg:col-span-7">
        <p class="text-lg sm:text-2xl text-granite/90 leading-relaxed font-light max-w-2xl" data-i18n-html="hero.description" set:html={t.description} />
      </div>

      <div class="lg:col-span-5 lg:border-l lg:border-rule lg:pl-10">
        <div class="p-4 sm:p-6 rounded-2xl bg-suomisoft/40 border border-rule">
          <p class="font-sans text-[11px] uppercase tracking-[0.25em] text-suomi mb-2 sm:mb-3 font-semibold" data-i18n="hero.locationLabel">{t.locationLabel}</p>
          <p class="font-nordic font-bold text-lg text-granite mb-1" data-i18n="hero.locationName">{t.locationName}</p>
          <p class="font-sans text-sm sm:text-base text-mute font-light" data-i18n="hero.locationDesc">{t.locationDesc}</p>
          <div class="mt-4 pt-4 border-t border-rule/60 flex flex-col sm:flex-row sm:items-center justify-between gap-1 text-xs font-sans">
            <span class="text-mute uppercase tracking-wider" data-i18n="hero.langLabel">{t.langLabel}</span>
            <span class="text-granite font-semibold" data-i18n="hero.langValue">{t.langValue}</span>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>
