---
import type { Show } from "../data/shows";
import { isShowActive } from "../data/shows";
import { translations } from "../data/translations";
import { CURRENT_YEAR } from "../utils/date";

interface Props {
  show: Show;
}

const { show } = Astro.props;
const t = translations.ru.showPage;
const afishaT = translations.ru.afisha;
const isActive = isShowActive(show);
const premiereYear = show.dateIso ? new Date(show.dateIso).getFullYear() : CURRENT_YEAR;
---

<section
  class="relative px-3 sm:px-10 pt-8 pb-16 sm:pb-28 bg-gradient-to-b from-snow2/70 via-snow to-snow border-b border-rule overflow-hidden"
>
  <!-- Back navigation bar -->
  <div class="max-w-[1400px] mx-auto mb-8 sm:mb-12">
    <a
      href="/#afisha"
      class="inline-flex items-center gap-2 font-nordic text-xs tracking-wider uppercase font-semibold text-suomi hover:text-suomidark transition-colors group"
    >
      <svg
        class="w-4 h-4 transform group-hover:-translate-x-1 transition-transform"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
      >
        <path d="M19 12H5M12 19l-7-7 7-7"></path>
      </svg>
      <span data-i18n="showPage.backToAfisha">{t.backToAfisha}</span>
    </a>
  </div>

  <div class="max-w-[1400px] mx-auto">
    <div class="grid lg:grid-cols-12 gap-8 lg:gap-14 items-center">
      <!-- Left Info Column -->
      <div class="lg:col-span-7 order-2 lg:order-1 reveal">
        <!-- Metadata Badges -->
        <div class="flex flex-wrap items-center gap-2.5 mb-6">
          {
            !isActive ? (
              <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-granite/10 text-granite font-sans text-xs font-semibold border border-granite/20">
                <span class="w-2 h-2 rounded-full bg-granite/40 inline-block"></span>
                <span data-i18n="showPage.expiredBadge">{t.expiredBadge || "Показ завершен"}</span>
              </span>
            ) : (
              <span
                class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-suomi text-white font-sans text-xs font-semibold shadow-xs"
              >
                <svg class="w-3.5 h-3.5 text-white/90 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                <span data-i18n={`afisha.shows.${show.id}.date`}>{show.date}</span> · {show.time}
              </span>
            )
          }
          {
            isActive && (
              <span
                class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-white text-granite font-sans text-xs font-semibold border border-rule shadow-xs"
              >
                <svg class="w-3.5 h-3.5 text-redru shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <span data-i18n={`afisha.shows.${show.id}.stage`}>{show.stage}</span>
              </span>
            )
          }
          <span
            class="px-3 py-1.5 rounded-full bg-redru/10 text-redru font-sans text-xs font-semibold border border-redru/20"
          >
            <span data-i18n={`afisha.shows.${show.id}.age`}>{show.age}</span>
          </span>

          <!-- Audience Rating Link Badge -->
          <a
            href="#reviews"
            class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-amber-50 hover:bg-amber-100/80 text-amber-950 font-sans text-xs font-semibold border border-amber-200/80 shadow-xs transition-all duration-200 hover:scale-105"
          >
            <span class="text-amber-500 font-bold">★ 4.9</span>
            <span class="text-mute">·</span>
            <span class="text-granite/80" data-i18n="showPage.reviewsTag">Отзывы</span>
          </a>
        </div>

        <!-- Title & Subtitle -->
        <h1
          class="font-nordic font-extrabold text-granite text-4xl sm:text-6xl lg:text-7xl mb-4 tracking-tight leading-none"
          data-i18n={`afisha.shows.${show.id}.title`}
        >
          {show.title}
        </h1>
        <p
          class="font-sans font-medium text-mute text-lg sm:text-2xl mb-8"
          data-i18n={`afisha.shows.${show.id}.subtitle`}
        >
          {show.subtitle}
        </p>

        <!-- Quote Block -->
        {
          show.quote && (
            <blockquote class="relative my-7 p-6 sm:p-8 rounded-2xl bg-gradient-to-br from-suomisoft/70 via-white to-snow2/50 border border-rule/80 shadow-xs overflow-hidden group transition-all duration-300 hover:border-suomi/30">
              <div class="absolute -top-3 -left-2 text-6xl sm:text-7xl font-nordic text-suomi/10 font-black select-none pointer-events-none leading-none">
                “
              </div>
              <div class="relative z-10">
                <p
                  class="font-sans font-medium italic text-base sm:text-xl text-granite leading-relaxed tracking-tight"
                  data-i18n={`afisha.shows.${show.id}.quote`}
                >
                  {show.quote}
                </p>
              </div>
            </blockquote>
          )
        }

        <!-- Quick Facts Summary Grid -->
        <div class="grid grid-cols-3 gap-4 py-5 border-y border-rule my-8">
          <div>
            <p
              class="font-sans text-[10px] uppercase tracking-[0.2em] text-suomi font-bold mb-1"
              data-i18n="afisha.durationLabel"
            >
              {afishaT.durationLabel}
            </p>
            <p
              class="font-nordic font-bold text-base sm:text-lg text-granite"
              data-i18n={`afisha.shows.${show.id}.duration`}
            >
              {show.duration}
            </p>
          </div>
          <div>
            <p
              class="font-sans text-[10px] uppercase tracking-[0.2em] text-suomi font-bold mb-1"
              data-i18n="afisha.subtitlesLabel"
            >
              {afishaT.subtitlesLabel}
            </p>
            <p
              class="font-nordic font-bold text-base sm:text-lg text-granite"
              data-i18n={`afisha.shows.${show.id}.subtitles`}
            >
              {show.subtitles}
            </p>
          </div>
          <div>
            <p
              class="font-sans text-[10px] uppercase tracking-[0.2em] text-suomi font-bold mb-1"
            >
              Места
            </p>
            <p
              class="font-nordic font-bold text-base sm:text-lg text-granite"
              data-i18n={`afisha.shows.${show.id}.capacity`}
            >
              {show.capacity}
            </p>
          </div>
        </div>

        <!-- Action CTAs -->
        <div
          class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4"
        >
          {
            isActive ? (
              <a
                id="hero-book-btn"
                href={show.fientaUrl ||
                  "https://fienta.com/ru/spektakl-novechento-chetverg-13-avgusta-19-00-21-00"}
                target="_blank"
                rel="noopener"
                class="btn-suomi font-nordic text-xs tracking-wider uppercase font-semibold px-8 py-4 rounded-full inline-flex items-center justify-center gap-3 group cursor-pointer shadow-md"
              >
                <span data-i18n="showPage.bookSeatBtn">{t.bookSeatBtn}</span>
                <svg
                  class="arrow"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"></path></svg
                >
              </a>
            ) : (
              <a
                href="/#afisha"
                class="btn-suomi font-nordic text-xs tracking-wider uppercase font-semibold px-8 py-4 rounded-full inline-flex items-center justify-center gap-3 group cursor-pointer shadow-md"
              >
                <span data-i18n="showPage.backToAfisha">{t.backToAfisha}</span>
                <svg
                  class="arrow"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"></path></svg
                >
              </a>
            )
          }
          <a
            href="#gallery"
            class="btn-outline font-nordic text-xs tracking-wider uppercase font-semibold px-7 py-4 rounded-full text-center inline-flex items-center justify-center gap-2"
          >
            <span data-i18n="showPage.galleryBtn">{t.galleryBtn}</span> ↓
          </a>
        </div>
      </div>

      <!-- Right Poster Column -->
      <div
        class="lg:col-span-5 order-1 lg:order-2 reveal flex items-center justify-center"
      >
        <div
          class="relative w-full max-w-md group rounded-3xl overflow-hidden bg-white p-3 border border-rule shadow-xl"
        >
          <div class="overflow-hidden rounded-2xl bg-granite/5">
            <img
              src={show.poster}
              alt={show.title}
              class="w-full h-auto max-h-[65vh] object-contain rounded-xl transform transition-transform duration-700 group-hover:scale-102"
            />
          </div>
          <div
            class="p-4 bg-white/90 backdrop-blur-md flex items-center justify-between text-xs font-nordic"
          >
            <span class="text-suomi font-bold">Logrus Teatteri</span>
            <span class="text-mute uppercase tracking-widest"
              >Premieeri {premiereYear}</span
            >
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
