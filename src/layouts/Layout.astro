---
import { ClientRouter } from 'astro:transitions';
import "../styles/global.css";
import type { Language } from '../data/translations';
import { getOrganizationSchema, getCourseSchema } from '../utils/seo';
import { getAlternateHreflangLinks } from '../utils/i18n';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  keywords?: string;
  canonicalUrl?: string;
  schema?: Record<string, any> | Record<string, any>[];
  lang?: Language;
}

const {
  lang = "ru",
  title = "Logrus Teatteri — Русскоязычный театр и курсы актерского мастерства в Хельсинки",
  description = "Камерный русскоязычный театр в Хельсинки на сцене Narri näyttämö (Sörnäisten rantatie 31). Спектакли, афиша, билеты, театральная студия и курсы актерского мастерства для взрослых в Хельсинки, Эспоо и Вантаа.",
  image = "/logo.png",
  type = "website",
  keywords = "русский театр хельсинки, театр хельсинки, курсы актерского мастерства хельсинки, актерские курсы эспоо, театральная студия вантаа, спектакли на русском хельсинки, афиша хельсинки, русский театр в финляндии, teatteri helsinki, venäjänkielinen teatteri, acting classes helsinki, logrus teatteri",
  canonicalUrl,
  schema = [getOrganizationSchema(lang), getCourseSchema(lang)],
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://teatterilogrus.fi';
const canonical = canonicalUrl || new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = image.startsWith('http') ? image : `${siteUrl}${image.startsWith('/') ? '' : '/'}${image}`;
const structuredData = Array.isArray(schema) ? schema : [schema];
const alternateHreflangs = getAlternateHreflangLinks(Astro.url.pathname, siteUrl);

const localeMap: Record<Language, { current: string; alternates: string[] }> = {
  ru: { current: 'ru_RU', alternates: ['fi_FI', 'en_US'] },
  fi: { current: 'fi_FI', alternates: ['ru_RU', 'en_US'] },
  en: { current: 'en_US', alternates: ['ru_RU', 'fi_FI'] }
};
const { current: currentLocale, alternates: alternateLocales } = localeMap[lang] || localeMap.ru;
---

<!doctype html>
<html lang={lang}>
  <head>
    <!-- Essential Meta Tags -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Logrus Teatteri" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonical} />

    <!-- Hreflang Multi-language Alternate Links for Search Engines -->
    {
      alternateHreflangs.map((link) => (
        <link rel="alternate" hreflang={link.lang} href={link.href} />
      ))
    }

    <ClientRouter />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Logrus Teatteri" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={currentLocale} />
    {
      alternateLocales.map((loc) => (
        <meta property="og:locale:alternate" content={loc} />
      ))
    }

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Local SEO Geo Meta Tags (Helsinki / Capital Region) -->
    <meta name="geo.region" content="FI-18" />
    <meta name="geo.placename" content="Helsinki, Finland" />
    <meta name="geo.position" content="60.1834;24.9652" />
    <meta name="ICBM" content="60.1834, 24.9652" />

    <!-- Theme & Icons -->
    <meta name="theme-color" content="#002F6C" />
    <meta name="apple-mobile-web-app-title" content="Logrus Teatteri" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/logo.png" />

    <!-- Preload Critical Local Fonts (Eliminates Google Fonts Render-Blocking & Font-Flash) -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href="/fonts/unbounded-cyrillic.woff2"
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href="/fonts/unbounded-latin.woff2"
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href="/fonts/plus-jakarta-sans-cyrillic.woff2"
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href="/fonts/plus-jakarta-sans-latin.woff2"
    />

    <!-- Schema.org JSON-LD Structured Data -->
    {
      structuredData.map((schemaObj) => (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(schemaObj)}
        />
      ))
    }

    <!-- Yandex.Metrika counter (non-blocking) -->
    <script type="text/javascript" is:inline>
      window.addEventListener('DOMContentLoaded', function() {
        (function(m,e,t,r,i,k,a){
          m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
          m[i].l=1*new Date();
          for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
          k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)
        })(window, document,'script','https://mc.yandex.ru/metrika/tag.js?id=111679649', 'ym');

        ym(111679649, 'init', {ssr:true, webvisor:true, clickmap:true, referrer: document.referrer, url: location.href, accurateTrackBounce:true, trackLinks:true});
      });
    </script>
    <noscript><div><img src="https://mc.yandex.ru/watch/111679649" style="position:absolute; left:-9999px;" alt="" /></div></noscript>
    <!-- /Yandex.Metrika counter -->

    <!-- Fienta Ticketing Embed Script -->
    <script is:inline>
      window.fientaSettings = {
        background: "rgba(15, 23, 42, 0.65)",
        border_radius: "16px",
      };
    </script>
    <script src="https://fienta.com/embed.js" is:inline defer></script>
  </head>
  <body>
    <slot />

    <script>
      function setupPage() {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("in");
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.05 },
        );

        document.querySelectorAll(".reveal").forEach((el) => io.observe(el));

        // Track page hit in Yandex.Metrika on view transitions
        if (typeof (window as any).ym === 'function') {
          (window as any).ym(111679649, 'hit', window.location.href);
        }
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", setupPage);
      } else {
        setupPage();
      }

      document.addEventListener("astro:page-load", setupPage);
    </script>
  </body>
</html>
