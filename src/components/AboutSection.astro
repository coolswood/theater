---
import { translations } from "../data/translations";
const t = translations.ru.about;
---

<section
  id="about"
  class="px-3 sm:px-10 py-12 sm:py-32 border-t border-rule bg-suomisoft/30"
>
  <div class="max-w-[1400px] mx-auto">
    <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 mb-12 sm:mb-20">
      <div class="lg:col-span-7 reveal">
        <span class="suomi-tag block mb-3 sm:mb-4" data-i18n="about.tag"
          >{t.tag}</span
        >
        <h2
          class="font-nordic font-extrabold text-granite text-3xl sm:text-6xl lg:text-7xl leading-tight"
          data-i18n-html="about.title"
          set:html={t.title}
        />
      </div>
      <div class="lg:col-span-5 reveal lg:pt-10">
        <p
          class="font-sans font-semibold text-lg sm:text-2xl text-granite leading-snug mb-4 sm:mb-6 border-l-4 border-suomi pl-4"
          data-i18n="about.italicQuote"
        >
          {t.italicQuote}
        </p>
        <p
          class="text-base sm:text-lg text-mute font-light leading-relaxed"
          data-i18n="about.text"
        >
          {t.text}
        </p>
      </div>
    </div>

    <div class="reveal">
      <div class="flex items-center justify-between mb-3 sm:hidden">
        <span
          class="font-nordic font-bold text-xs text-granite"
          data-i18n="about.mobileFeaturesTitle">{t.mobileFeaturesTitle}</span
        >
        <span
          class="font-sans text-[10px] text-mute uppercase tracking-widest"
          data-i18n="about.swipeLabel">{t.swipeLabel}</span
        >
      </div>

      <div
        class="flex md:grid md:grid-cols-3 gap-4 md:gap-8 overflow-x-auto md:overflow-visible snap-x snap-mandatory scrollbar-none pb-3 md:pb-0 -mx-3 px-3 md:mx-0 md:px-0"
      >
        <article
          class="w-[85vw] sm:w-[360px] md:w-full md:max-w-none shrink-0 md:shrink snap-center p-6 md:p-10 lg:p-12 rounded-2xl md:rounded-3xl bg-snow border border-rule flex flex-col justify-between min-h-[220px] md:min-h-[300px] shadow-sm hover:shadow-md transition-all"
        >
          <div>
            <span
              class="font-sans text-xs md:text-sm text-suomi font-bold tracking-widest"
              data-i18n="about.feature1Tag">{t.feature1Tag}</span
            >
            <h3
              class="font-nordic font-bold text-granite text-xl md:text-2xl lg:text-3xl mt-4 mb-3"
              data-i18n="about.feature1Title"
            >
              {t.feature1Title}
            </h3>
          </div>
          <p
            class="text-sm md:text-base lg:text-lg text-mute leading-relaxed font-light"
            data-i18n="about.feature1Desc"
          >
            {t.feature1Desc}
          </p>
        </article>

        <article
          class="w-[85vw] sm:w-[360px] md:w-full md:max-w-none shrink-0 md:shrink snap-center p-6 md:p-10 lg:p-12 rounded-2xl md:rounded-3xl bg-snow border border-rule flex flex-col justify-between min-h-[220px] md:min-h-[300px] shadow-sm hover:shadow-md transition-all"
        >
          <div>
            <span
              class="font-sans text-xs md:text-sm text-suomi font-bold tracking-widest"
              data-i18n="about.feature2Tag">{t.feature2Tag}</span
            >
            <h3
              class="font-nordic font-bold text-granite text-xl md:text-2xl lg:text-3xl mt-4 mb-3"
              data-i18n="about.feature2Title"
            >
              {t.feature2Title}
            </h3>
          </div>
          <p
            class="text-sm md:text-base lg:text-lg text-mute leading-relaxed font-light"
            data-i18n="about.feature2Desc"
          >
            {t.feature2Desc}
          </p>
        </article>

        <article
          class="w-[85vw] sm:w-[360px] md:w-full md:max-w-none shrink-0 md:shrink snap-center p-6 md:p-10 lg:p-12 rounded-2xl md:rounded-3xl bg-snow border border-rule flex flex-col justify-between min-h-[220px] md:min-h-[300px] shadow-sm hover:shadow-md transition-all"
        >
          <div>
            <span
              class="font-sans text-xs md:text-sm text-redru font-bold tracking-widest"
              data-i18n="about.feature3Tag">{t.feature3Tag}</span
            >
            <h3
              class="font-nordic font-bold text-granite text-xl md:text-2xl lg:text-3xl mt-4 mb-3"
              data-i18n="about.feature3Title"
            >
              {t.feature3Title}
            </h3>
          </div>
          <p
            class="text-sm md:text-base lg:text-lg text-mute leading-relaxed font-light"
            data-i18n="about.feature3Desc"
          >
            {t.feature3Desc}
          </p>
        </article>
      </div>
    </div>
  </div>
</section>
