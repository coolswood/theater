---
import { translations, type Language } from "../data/translations";
import { getNearestUpcomingShow } from "../data/shows";
import { CURRENT_YEAR } from "../utils/date";
import { getLocalizedPath } from "../utils/i18n";

interface Props {
  lang?: Language;
}

const { lang = "ru" } = Astro.props;
const t = translations[lang]?.hero || translations.ru.hero;
const nearestShow = getNearestUpcomingShow(lang);

// Toggle to true whenever announcement / vacancy card should be active
const showAnnouncement = false;

const vacancy = t.vacancy || {
  tag: "Вакансия // Команда",
  titlePrefix: "ИЩЕМ",
  titleHighlight: "СЦЕНОГРАФА",
  role: "Сценография · Декорации · Реквизит",
  intro: "Приглашаем в нашу команду творческого и мотивированного человека, которому интересно работать над созданием сценического пространства, декораций и реквизита для новой современной драматической постановки на русском языке.",
  invite: "Если вам близок театр и хочется воплотить свои идеи на сцене — будем рады знакомству!",
  note: "Опыт приветствуется, но не обязателен. Главное — интерес, желание творить и работать вместе!",
  signoff: "Ждём вас в Театре Logrus!",
  contactLabel: "СВЯЗЬ:",
  applyBtn: "Откликнуться на вакансию",
  phone: "045 2656332",
  email: "info@logrus.fi"
};

const vacancyEmailSubjects: Record<Language, string> = {
  ru: "Отклик на вакансию: Сценограф / Театр Logrus",
  fi: "Yhteydenotto: Lavastaja / Logrus Teatteri",
  en: "Application: Scenographer / Logrus Teatteri"
};
const vacancyEmailBodies: Record<Language, string> = {
  ru: "Здравствуйте! Хочу откликнуться на вакансию сценографа в театре Logrus.",
  fi: "Hei! Haluan hakea lavastajan tehtävään Logrus Teatterissa.",
  en: "Hello! I would like to apply for the scenographer position at Logrus Teatteri."
};
const vacancySubject = encodeURIComponent(vacancyEmailSubjects[lang] || vacancyEmailSubjects.ru);
const vacancyBody = encodeURIComponent(vacancyEmailBodies[lang] || vacancyEmailBodies.ru);
---

<section
  id="top"
  class="relative px-3 sm:px-10 pt-12 sm:pt-20 pb-16 sm:pb-24 border-b border-rule bg-nordic-grid overflow-hidden"
>
  <!-- Atmospheric Nordic Glow Background Effect -->
  <div class="nordic-glow"></div>

  <div class="max-w-[1400px] mx-auto relative z-10">
    <!-- Top Metadata Bar -->
    <div class="flex flex-wrap items-center gap-3 sm:gap-4 mb-6 sm:mb-8 reveal">
      <span class="suomi-tag font-semibold"
        >{t.countryTag}</span
      >
      <span class="text-rule">/</span>
      <span
        class="font-sans text-xs uppercase tracking-[0.15em] sm:tracking-[0.2em] text-mute flex items-center gap-2"
      >
        <span class="w-2 h-2 rounded-full bg-redru inline-block"></span>
        <span>{t.stageTag}</span>
      </span>

      <!-- Architectural Coordinates Tag -->
      <div class="hidden md:flex items-center gap-2 ml-auto text-[11px] font-mono text-mute/70 tracking-widest bg-white/60 backdrop-blur-sm px-3 py-1 rounded-full border border-rule/80">
        <span class="w-1.5 h-1.5 rounded-full bg-suomi/50"></span>
        <span>60°10'15"N · 24°57'40"E</span>
      </div>
    </div>

    <!-- Main Dynamic Hero Title -->
    <h1
      class="font-nordic font-semibold text-granite leading-[1.08] text-[7.8vw] sm:text-[5.5vw] lg:text-[5rem] xl:text-[5.6rem] tracking-tight reveal mb-8"
      set:html={t.title}
    />

    <!-- Description & Hero Feature Grid -->
    <div
      class="grid lg:grid-cols-12 gap-8 lg:gap-12 mt-8 sm:mt-12 reveal items-stretch"
    >
      <!-- Description & Interactive CTAs -->
      <div class="lg:col-span-7 flex flex-col justify-between space-y-8">
        <p
          class="text-lg sm:text-2xl text-granite/90 leading-relaxed font-light max-w-2xl"
          set:html={t.description}
        />

        <!-- Action Buttons Row -->
        <div class="flex flex-wrap items-center gap-4 pt-2">
          {
            nearestShow ? (
              <a
                href="#afisha"
                class="btn-suomi inline-flex items-center gap-3 px-6 py-3.5 rounded-xl font-sans text-sm font-semibold tracking-wide shadow-sm group"
              >
                <span>{t.afishaBtn || "Смотреть афишу"}</span>
                <svg
                  class="w-4 h-4 arrow shrink-0 transform group-hover:translate-y-0.5 transition-transform"
                  width="16"
                  height="16"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2.2"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
                </svg>
              </a>
            ) : (
              <a
                href="#courses"
                class="btn-suomi inline-flex items-center gap-3 px-6 py-3.5 rounded-xl font-sans text-sm font-semibold tracking-wide shadow-sm group"
              >
                <span>{translations[lang]?.courses?.centralCourse?.title || "Актерские курсы"}</span>
                <svg
                  class="w-4 h-4 arrow shrink-0 transform group-hover:translate-y-0.5 transition-transform"
                  width="16"
                  height="16"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2.2"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
                </svg>
              </a>
            )
          }

          <a
            href="#about"
            class="btn-outline inline-flex items-center gap-2 px-5 py-3.5 rounded-xl font-sans text-sm font-medium tracking-wide"
          >
            <span>{t.aboutBtn || "О театре"}</span>
          </a>
        </div>
      </div>

      {
        showAnnouncement ? (
          <div class="lg:col-span-5 flex">
            <aside
              aria-label={`${vacancy.titlePrefix} ${vacancy.titleHighlight}`}
              class="w-full p-6 sm:p-7 rounded-2xl hero-card-glass flex flex-col justify-between border border-rule/90 relative overflow-hidden group shadow-sm hover:shadow-md transition-all duration-300"
            >
              <!-- Subtle decorative accent glow and Nordic geometric motif from poster -->
              <div class="absolute -top-16 -right-16 w-36 h-36 bg-suomi/10 rounded-full blur-2xl pointer-events-none group-hover:bg-suomi/20 transition-all"></div>
              <div class="absolute -top-10 -right-10 w-44 h-44 rounded-full border border-suomi/10 pointer-events-none"></div>
              <div class="absolute top-5 right-5 text-redru/60 text-xs pointer-events-none select-none font-serif">✦</div>

              <div>
                <!-- Top Status Pill & Year -->
                <div class="flex items-center justify-between gap-3 mb-4">
                  <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-suomi/10 text-suomi text-[11px] font-bold font-sans uppercase tracking-wider border border-suomi/20">
                    <span class="w-2 h-2 rounded-full bg-redru animate-pulse"></span>
                    <span>{vacancy.tag}</span>
                  </span>

                  <span class="font-sans text-[11px] text-mute font-medium">Logrus {CURRENT_YEAR}</span>
                </div>

                <!-- Headline in site typography: ИЩЕМ СЦЕНОГРАФА -->
                <div class="mb-3.5">
                  <h2 class="font-nordic font-black text-2xl sm:text-3xl lg:text-[2rem] text-granite leading-[1.08] tracking-tight uppercase">
                    <span>{vacancy.titlePrefix}</span>{" "}
                    <span class="text-suomi block sm:inline">{vacancy.titleHighlight}</span>
                    <span class="text-redru font-normal">.</span>
                  </h2>
                  <div class="mt-2 inline-block">
                    <span class="inline-flex items-center px-2.5 py-1 rounded-lg bg-granite text-white font-nordic text-[11px] font-bold uppercase tracking-wider shadow-xs">
                      {vacancy.role}
                    </span>
                  </div>
                </div>

                <!-- Text block with vertical accent line matching the poster layout -->
                <div class="border-l-2 border-granite/25 hover:border-suomi/50 transition-colors pl-3.5 sm:pl-4 py-0.5 my-3.5 space-y-2.5">
                  <p class="font-sans text-xs sm:text-[13px] text-granite/90 leading-relaxed font-light">
                    {vacancy.intro}
                  </p>
                  <p class="font-sans text-xs sm:text-[13px] text-granite/90 leading-relaxed font-light">
                    {vacancy.invite}
                  </p>
                  <p class="font-sans text-xs sm:text-[13px] text-granite/80 leading-relaxed font-light">
                    {vacancy.note}
                  </p>
                  <p class="font-nordic font-bold text-xs sm:text-[13px] text-granite pt-0.5">
                    {vacancy.signoff}
                  </p>
                </div>
              </div>

              <!-- Bottom Contact & Action Area with red accent line -->
              <div class="pt-4 border-t border-rule/80 space-y-3">
                <div class="border-l-2 border-redru pl-3 py-0.5">
                  <div class="font-sans text-[10px] sm:text-[11px] font-bold uppercase tracking-widest text-redru mb-1">
                    {vacancy.contactLabel}
                  </div>
                  <div class="flex flex-wrap items-center justify-between gap-2 text-xs sm:text-[13px] font-sans">
                    <a
                      href={`tel:${vacancy.phone.replace(/\s+/g, '')}`}
                      class="inline-flex items-center gap-1.5 text-granite hover:text-suomi font-semibold transition-colors"
                    >
                      <svg class="w-3.5 h-3.5 text-redru shrink-0" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                      </svg>
                      <span>{vacancy.phone}</span>
                    </a>

                    <a
                      href={`mailto:${vacancy.email}?subject=${vacancySubject}&body=${vacancyBody}`}
                      class="inline-flex items-center gap-1.5 text-granite hover:text-suomi font-medium transition-colors"
                    >
                      <svg class="w-3.5 h-3.5 text-suomi shrink-0" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                      </svg>
                      <span>{vacancy.email}</span>
                    </a>
                  </div>
                </div>

                <a
                  href={`mailto:${vacancy.email}?subject=${vacancySubject}&body=${vacancyBody}`}
                  class="w-full btn-suomi py-2.5 px-4 rounded-xl font-nordic text-[11px] uppercase tracking-wider font-semibold inline-flex items-center justify-center gap-2 group/btn shadow-xs cursor-pointer"
                >
                  <span>{vacancy.applyBtn}</span>
                  <svg class="w-3.5 h-3.5 arrow shrink-0" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </a>
              </div>
            </aside>
          </div>
        ) : (
          <div class="lg:col-span-5 flex">
            <div class="w-full p-6 sm:p-7 rounded-2xl hero-card-glass flex flex-col justify-between border border-rule/90">
              <div>
                {
                  nearestShow ? (
                    <a
                      href={getLocalizedPath(`/shows/${nearestShow.id}`, lang)}
                      class="inline-flex flex-wrap items-center gap-2 px-3 py-1.5 rounded-full bg-suomisoft/80 text-suomi text-xs font-semibold mb-5 border border-suomi/15 hover:bg-suomisoft transition group"
                    >
                      <span class="w-2 h-2 rounded-full bg-suomi inline-block animate-pulse"></span>
                      <span>{t.nextShowLabel || "Ближайший показ"}</span>
                      <span class="text-suomi/30">|</span>
                      <span class="font-normal text-granite/90 group-hover:text-suomi transition-colors">
                        «<span>{nearestShow.title}</span>» · <span>{nearestShow.date}</span>
                      </span>
                    </a>
                  ) : (
                    <div class="inline-flex flex-wrap items-center gap-2 px-3 py-1.5 rounded-full bg-snow2 text-mute text-xs font-medium mb-5 border border-rule/70">
                      <span class="w-2 h-2 rounded-full bg-suomi/40 inline-block"></span>
                      <span>{t.noUpcomingBadge || "Репертуар формируется"}</span>
                      <span class="text-mute/40">|</span>
                      <span class="text-granite/80">{t.noUpcomingShows || "Скоро новые анонсы"}</span>
                    </div>
                  )
                }

                <p
                  class="font-sans text-[11px] uppercase tracking-[0.25em] text-suomi mb-2 font-semibold"
                >
                  {t.locationLabel}
                </p>
                <p
                  class="font-nordic font-bold text-xl text-granite mb-1.5"
                >
                  {t.locationName}
                </p>
                <p
                  class="font-sans text-sm sm:text-base text-mute font-light leading-relaxed"
                >
                  {t.locationDesc}
                </p>
              </div>

              <div
                class="mt-6 pt-4 border-t border-rule/80 flex items-center justify-between gap-2 text-xs font-sans"
              >
                <span
                  class="text-mute uppercase tracking-wider">{t.langLabel}</span
                >
                <span class="text-granite font-semibold bg-white/80 px-2.5 py-1 rounded-md border border-rule/60"
                  >{t.langValue}</span>
              </div>
            </div>
          </div>
        )
      }
    </div>
  </div>
</section>
